// Get tracking label from menu item
function getTrackingLabel(li) {
  var link = li.querySelector('a');
  if (!link) return '';

  var label = link.getAttribute('data-tracking-label');
  return label || '';
}

// Reorder menu items based on priority
function reorderMenu(menu) {
  var items = Array.prototype.slice.call(
    menu.querySelectorAll('.user-menu-list-item')
  );

  if (!items.length) return;

  var priorityMap = {
    "masthead_user_bills_and_payments": 1,
    "masthead_user_your_products": 2,
    "masthead_user_order_tracking": 3,
    "masthead_user_my_details": 4,
    "masthead_user_product_settings": 5,
    "masthead_user_message_centre": 6,
    "masthead_user_service_checker": 7,
    "masthead_rewards_and_extras": 8,
    "masthead_user_moving_home": 9,
    "masthead_user_yahoo_mail": 10,
    "masthead_user_refer_a_friend": 11
  };

  var sorted = items.slice().sort(function (a, b) {
    var aPriority = priorityMap[getTrackingLabel(a)] || 999;
    var bPriority = priorityMap[getTrackingLabel(b)] || 999;
    return aPriority - bPriority;
  });

  var changed = items.some(function (item, i) {
    return item !== sorted[i];
  });

  if (!changed) return;

  var fragment = document.createDocumentFragment();
  sorted.forEach(function (el) {
    fragment.appendChild(el);
  });

  menu.appendChild(fragment);
}

// Simple debounce
function debounce(fn, delay) {
  var timer;
  return function () {
    clearTimeout(timer);
    timer = setTimeout(fn, delay);
  };
}

// Initialise once menu is open
function init(menu) {
  if (hasInitialised) return;
  if (!menu) return;

  hasInitialised = true;

  reorderMenu(menu);

  var debouncedReorder = debounce(function () {
    reorderMenu(menu);
  }, 100);

  var menuObserver = new MutationObserver(function () {
    debouncedReorder();
  });

  menuObserver.observe(menu, { childList: true });
}

// Check if menu is open
function isMenuOpen() {
  var toggle = document.querySelector('.user-menu-toggle');
  return toggle && toggle.getAttribute('aria-expanded') === 'true';
}

// Main observer: wait for menu open state
var observer = new MutationObserver(function () {
  var toggle = document.querySelector('.user-menu-toggle');
  if (!toggle) return;

  // Only run when dropdown is open
  if (toggle.getAttribute('aria-expanded') !== 'true') return;

  var firstItem = document.querySelector('.user-menu-list-item');
  if (!firstItem) return;

  var menu = firstItem.parentElement;
  if (!menu) return;

  init(menu);
});

// Watch for aria-expanded changes (menu open/close)
observer.observe(document.body, {
  attributes: true,
  subtree: true,
  attributeFilter: ['aria-expanded']
});
}}]}]}], "weightDistributions": [{"entityId": "5877371253817344", "endOfRange": 10000}], "name": "IA_768_ReorderItemsInAccountNav", "bucketingStrategy": null, "experimentMetadata": {"allocationPolicy": "manual", "layerId": "5385151845236736"}, "deployed": true}], "policy": "single_experiment", "viewIds": ["5318678099525632"], "weightDistributions": null, "decisionMetadata": null, "concluded": true}, {"changes": null, "id": "6543224580341760", "name": "MERCH - /tv/apps/ - Page Alterations (Mobile)", "commitId": "4631392500318208", "groupId": null, "holdback": 0, "activation": {}, "integrationSettings": {}, "integrationStringVersion": 2, "experiments": [{"audienceIds": ["and", "6120114064457728"], "audienceName": "Mobile Users", "changes": null, "id": "4593923205627904", "integrationSettings": null, "variations": [{"id": "5930099007029248", "name": "Original", "actions": []}, {"id": "5896758316761088", "name": "Variation #1", "actions": [{"viewId": "6358740501266432", "changes": [{"css": {}, "dependencies": [], "attributes": {"remove": true}, "type": "attribute", "id": "7A35F392-E50C-425B-B6C8-85DCA9613D78", "selector": "[data-test-id=\"product-card-portrait-3\"]"}]}]}], "weightDistributions": [{"entityId": "5896758316761088", "endOfRange": 10000}], "name": "MERCH - /tv/apps/ - Page Alterations (Mobile)", "bucketingStrategy": null, "experimentMetadata": {"allocationPolicy": "manual", "layerId": "6543224580341760"}, "deployed": false}], "policy": "single_experiment", "viewIds": ["6358740501266432"], "weightDistributions": null, "decisionMetadata": null, "concluded": false}, {"changes": null, "id": "5388811593580544", "name": "MERCH - /tv/apps/ - Page Alterations (Desktop)", "commitId": "5796754566676480", "groupId": null, "holdback": 0, "activation": {}, "integrationSettings": {}, "integrationStringVersion": 2, "experiments": [{"audienceIds": ["and", "5254231276388352"], "audienceName": "Desktop & Tablet Users", "changes": null, "id": "5515275429216256", "integrationSe