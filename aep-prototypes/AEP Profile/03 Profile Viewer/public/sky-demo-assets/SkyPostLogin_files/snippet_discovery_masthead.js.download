n=__webpack_require__(1458);n.time("gtagReady");var e=__webpack_require__(5740),i=__webpack_require__(4089);__webpack_require__(266);var r=i.get("stores/directive");if(!__webpack_require__(7316).isCORSSupported())throw new Error("CORS is not supported on this browser, aborting.");var o,a=__webpack_require__(9237),u=__webpack_require__(8438),c=__webpack_require__(1555),s=__webpack_require__(1067),f={"accountId": "2900460605", "namespace": "a2900460605", "revision": "3303", "anonymizeIP": true, "enableForceParameters": true, "experimental": {"trimPages": true}, "snippetId": "23948490683", "projectId": "23948490683", "layers": [{"changes": null, "id": "6567178843979776", "name": "EXP-912 Sports PHP", "commitId": "5587978242752512", "groupId": null, "holdback": 0, "activation": {}, "integrationSettings": {}, "integrationStringVersion": 2, "experiments": [{"audienceIds": ["and", "24627820073"], "audienceName": "QA: Cookie", "changes": null, "id": "5868581676646400", "integrationSettings": null, "variations": [{"id": "6729052168388608", "name": "Original", "actions": []}, {"id": "6197553086070784", "name": "Variation #1", "actions": [{"viewId": "4770005814870016", "changes": [{"id": "C1EFD058-3FD6-44ED-B75A-7E2AF6E465AD", "type": "custom_code", "value": function($){(function () {

  const DESKTOP =
    'https://cdn.optimizely.com/img/2900460605/b98f00b030bf49bd91c08fddc667061d.png';

  const MOBILE =
    'https://cdn.optimizely.com/img/2900460605/cdcefd7fab1242c5835710fe88dd4593.png';

  function swapImage() {

    const img = document.querySelector(
      '[data-test-id="php-image-bg-asset"] img'
    );

    if (!img) {
      return false;
    }

    const newSrc =
      window.innerWidth <= 768
        ? MOBILE
        : DESKTOP;

    img.src = newSrc;
    img.srcset = newSrc;
    img.setAttribute('src', newSrc);
    img.setAttribute('srcset', newSrc);

    return true;
  }

  swapImage();

  const observer = new MutationObserver(() => {
    swapImage();
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });

})();
