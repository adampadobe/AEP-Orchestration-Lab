5.586 8l.707.707Z\" fill-rule=\"evenodd\" clip-rule=\"evenodd\"></path></g></svg></span>70+ channels, Includes Sky Atlantic.</li>", "attributes": {}, "type": "append", "id": "04A206C1-A695-443E-85EF-0184A880FC36", "selector": "div:nth-of-type(2) > div > div[data-skyui-core='Box@13.1.1'] > [data-skyui-core='Flex@13.1.1'] > div > [data-skyui-core='Flex@13.1.1'] > [data-skyui-core='Flex@13.1.1'] > ul[data-skyui-core='Markdown@13.1.1'] > li:nth-of-type(1)"}, {"css": {}, "isOpalManaged": false, "dependencies": ["04A206C1-A695-443E-85EF-0184A880FC36"], "name": "", "attributes": {"html": "<span class=\"list-item__IconWrapper-sc-1em5na7-1 cYVlBI\" data-optly-04a206c1-a695-443e-85ef-0184a880fc36=\"\">\n  <svg aria-hidden=\"true\" data-skyui-core=\"Icon@13.1.1\" viewBox=\"0 0 32 32\" class=\"icon__Svg-sc-wdtbmy-0 egOLRB\" data-optly-04A206C1-A695-443E-85EF-0184A880FC36=\"\">\n    <g data-optly-04A206C1-A695-443E-85EF-0184A880FC36=\"\">\n      <path d=\"M26.293 8.707a1 1 0 0 1 0 1.414L13 23.414a.999.999 0 0 1-1.414 0l-6.293-6.293a.999.999 0 0 1 0-1.414L6 15l6.293 6.293L25.586 8l.707.707Z\" fill-rule=\"evenodd\" clip-rule=\"evenodd\" data-optly-04A206C1-A695-443E-85EF-0184A880FC36=\"\">\n      </path>\n    </g>\n  </svg>\n</span>\n70+ channels, including Sky Atlantic."}, "type": "attribute", "id": "04A206C1-A695-443E-85EF-3CF60627", "selector": "#optly-duplicate-472071F2"}, {"css": {}, "isOpalManaged": false, "dependencies": [], "name": "", "attributes": {"html": "<span class=\"list-item__IconWrapper-sc-1em5na7-1 cYVlBI\">\n  <svg aria-hidden=\"true\" data-skyui-core=\"Icon@13.1.1\" viewBox=\"0 0 32 32\" class=\"icon__Svg-sc-wdtbmy-0 egOLRB\">\n    <g>\n      <path d=\"M26.293 8.707a1 1 0 0 1 0 1.414L13 23.414a.999.999 0 0 1-1.414 0l-6.293-6.293a.999.999 0 0 1 0-1.414L6 15l6.293 6.293L25.586 8l.707.707Z\" fill-rule=\"evenodd\" clip-rule=\"evenodd\">\n      </path>\n    </g>\n  </svg>\n</span>\nOur lowest-priced Sky TV package."}, "type": "attribute", "id": "4D66F3D0-BE54-4089-A757-343F50E6DB27", "selector": "div:nth-of-type(2) > div > div[data-skyui-core='Box@13.1.1'] > [data-skyui-core='Flex@13.1.1'] > div > [data-skyui-core='Flex@13.1.1'] > [data-skyui-core='Flex@13.1.1'] > ul[data-skyui-core='Markdown@13.1.1'] > li:nth-of-type(1)"}]}]}], "weightDistributions": [{"entityId": "6089459563757568", "endOfRange": 5000}, {"entityId": "5737547324719104", "endOfRange": 10000}], "name": "EXP-915 | ROI TV Discovery Page - Deal Cards Optimisations ", "bucketingStrategy": null, "experimentMetadata": {"allocationPolicy": "manual", "layerId": "4837611921997824"}, "deployed": false}], "policy": "single_experiment", "viewIds": ["5046864708370432"], "weightDistributions": null, "decisionMetadata": null, "concluded": false}, {"changes": null, "id": "6421555555598336", "name": "EXP-MERCH-14 Sky Go upsell on Sports DC", "commitId": "5188774078971904", "groupId": null, "holdback": 0, "activation": {}, "integrationSettings": {}, "integrationStringVersion": 2, "experiments": [{"audienceIds": null, "audienceName": "Everyone else", "changes": null, "id": "6023717298372608", "integrationSettings": null, "variations": [{"id": "4972140055756800", "name": "Original", "actions": []}, {"id": "6313465925599232", "name": "Variation #1", "actions": [{"viewId": "28370991178", "changes": [{"id": "39F6FC00-5097-4788-BB7E-B1127318044F", "type": "custom_code", "value": function($){(function () {
  var targetHeadingIds = [
    'heading-stream_netflix_sports',
    'heading-stream_netflix_sports_UTV'
  ];

  var copyToRemove = 'Watch straightaway on Sky Go after you order';

  function normalizeText(text) {
    return (text || '').replace(/\s+/g, ' ').trim();
  }

  function getCardByHeadingId(headingId) {
    return document.querySelector('[aria-labelledby="' + headingId + '"]');
  }

  function removeCopyFromCard(card) {
    if (!card) return;

    var spans = card.querySelectorAll('span');

    Array.prototype.forEach.call(spans, function (span) {
      if (normalizeText(span.textContent) !== copyToRemove) return;

      // Remove only the smallest wrapper whose full text is exactly the target copy
      var nodeToRemove = span;

      while (
        nodeToRemove.parentElement &&
        nodeToRemove.parentElement !== card &&
        normalizeText(nodeToRemove.parentElement.textContent) === copyToRemove
      ) {
        nodeToRemove = nodeToRemove.parentElement;
      }

      nodeToRemove.remove();
    });
  }

  function applyChanges() {
    targetHeadingIds.forEach(function (headingId) {
      var card = getCardByHeadingId(headingId);
      removeCopyFromCard(card);
    });
  }

  applyChanges();

  var observer = new MutationObserver(function () {
    applyChanges();
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });

  setTimeout(function () {
    observer.disconnect();
  }, 15000);
})();
}, "dependencies": []}]}]}], "weightDistributions": [{"entityId": "6313465925599232", "endOfRange": 10000}], "name": "EXP-MERCH-14 Sky Go upsell on Sports DC", "bucketingStrategy": null, "experimentMetadata": {"allocationPolicy": "manual", "layerId": "6421555555598336"}, "deployed": true}], "policy": "single_experiment", "viewIds": ["28370991178"], "weightDistributions": null, "decisionMetadata": null, "concluded": true}, {"changes": null, "id": "6185918046928896", "name": "EXP-819 Stream Redirect2", "commitId": "6398364349104128", "groupId": null, "holdback": 0, "activation": {}, "integrationSettings": {}, "integrationStringVersion": 2, "experiments": [{"audienceIds": ["and", "24582981020", "6490256980049920"], "audienceName": "GB Only (Exclude ROI),EXP-819 Stream LPTest", "changes": null, "id": "5622968093507584", "integrationSettings": null, "variations": [{"id": "5485413779898368", "name": "Original", "actions": []}, {"id": "5228030818254848", "name": "Variation #1", "actions": [{"viewId": "6362312555102208", "changes": [{"id": "a2c239cd4b8a4b24b3f6af0d4c386245", "type": "custom_code", "value": function($){(function () {
  var LEGAL_COPY_1 = "Includes Sky Ultimate TV, Netflix Standard with Ads, Disney+ Standard with Ads, HBO Max Basic with Ads and taste of Hayu. Requires Sky Stream and relevant TV subscriptions. 'Streaming sorted for less than £1 a day' based on £24pm price on 24m contract. £38pm after Min. term. Minimum broadband speed of 25Mbps recommended. 18+. All third party trade marks and copyrights are the property of their respective owners. All rights reserved. \n\nNew Sky Ultimate TV customers only. Requires Sky Stream and Sky Ultimate TV subscription £24pm on 24 month minimum term. Price and services may change. Upfront fee £0 (usually £20). Requires TV with HDMI port and broadband minimum recommended speed 30Mbps. Order by 9pm Mon-Fri or 3pm Sunday for next day delivery. Excludes Bank Holidays. Sky Stream Pucks are loaned to you at no cost and must be returned when they are no longer registered on your account. Streaming TV account required, manage online at sky.com or via the My Sky app. Email address required for account login. Includes Netflix Standard with Ads (RRP £4.99). Subject to status. 18+. Further terms apply.";
  var LEGAL_COPY_2 = "Includes Sky Ultimate TV, Netflix Standard with Ads, Disney+ Standard with Ads, HBO Max Basic with Ads and taste of Hayu. Requires Sky Stream and relevant TV subscriptions. 'Streaming sorted for less than £1 a day' based on £24pm price on 24m contract. £38pm after Min. term. Minimum broadband speed of 25Mbps recommended. 18+. All third party trade marks and copyrights are the property of their respective owners. All rights reserved. \n\nNew Sky Ultimate TV customers only. Requires Sky Stream and Sky Ultimate TV subscription £24pm on 24 month minimum term. Price and services may change. Upfront fee £0 (usually £20). Requires TV with HDMI port and broadband minimum recommended speed 30Mbps. Order by 9pm Mon-Fri or 3pm Sunday for next day delivery. Excludes Bank Holidays. Sky Stream Pucks are loaned to you at no cost and must be returned when they are no longer registered on your account. Streaming TV account required, manage online at sky.com or via the My Sky app. Email address required for account login. Includes Netflix Standard with Ads (RRP £4.99). Subject to status. 18+. Further terms apply.18+. Sky Broadband Full Fibre 300 available in selected Sky Fibre areas only. 55% UK availability. All prices include Sky Talk Pay As You Talk (new 24-month minimum term applies). All speeds measured to router (not device). Wi-Fi performance varies by device and home environment. Selected Fibre areas only. Speeds vary by location. Discount for 24 months on Sky Broadband Full Fibre 300 (£35 per month (pm) including line rental) and Sky Pay As You Talk (£0pm). Set-up fee: £0 (Usually £19.95). New 24-month minimum terms for Sky Broadband and Sky Talk. Standard prices apply after 24 months (currently £46pm for Sky Broadband Full Fibre 300 and £0 pm for Sky Pay As You Talk). Prices may change during contract. Offer not available with any other offers. Full Fibre 300: Average speeds: 300Mbps (download); 60Mbps (upload). Subject to status. Upfront payment may be required. General: Compatible line required; otherwise, £20 connection charge may apply. Separate 24-month contracts apply to Sky Essential TV (£15pm), Sky Broadband (£20pm), and Sky Talk (£0pm). Sky Hub is loaned to you at no cost, and it must be returned at the end of the broadband subscription. Non-standard set-up may cost extra. Prices may vary if you live in a flat. You must get any consents required (e.g., landlord’s). UK residential customers only. Calls to Sky cost 7p per minute plus your provider’s access charge. New Sky TV and Broadband customers only. \n\nHBO Max: Access to HBO Max Basic with Ads is included with your Sky Ultimate TV subscription and allows you to watch on two screens in HD. You can upgrade to HBO Max Standard or HBO Max Premium via Sky Marketplace, further terms apply. HBO Max is streamed over broadband; a minimum download speed of 5 Mbps is recommended for HBO Max Basic with Ads and HBO Max Standard and 50 Mbps for HBO Max Premium. To access HBO Max, you will need to have or create an HBO Max account and agree to HBO Max’s terms of use and privacy policy. \n\nSky Ultimate TV customers with pre-existing HBO Max: If you currently pay for HBO Max, taking this service via Sky may result in two HBO Max subscriptions. To avoid this, manage your existing subscription with your current provider before activating HBO Max through Sky. \n\nDisney+: Access to Disney+ Standard with Ads is included in Sky Ultimate TV and Sky Cinema subscriptions and allows you to watch on two screens in HD. You can upgrade to Disney+ Standard or Disney+ Premium via Sky Marketplace, further terms apply. Disney+ is streamed over broadband; a minimum download speed of 5 Mbps is recommended for Disney+ Standard with Ads and Disney+ Standard and 25 Mbps for Disney+ Premium. To access Disney+, you will need to have or create a Disney+ account and agree to Disney’s terms of use and privacy policy. \n\nDisney+ Standard with Ads worth £5.99 a month (based on Disney’s regular monthly price). \n\nUp to £300 Switching Credit: Visit sky.com/help/articles/switching-credit-offer for more info. \n\n£300 TV/Broadband/Calls/Line Rental Credit: Applicable to all providers. If you decide to switch your broadband, calls and line rental to Sky and your provider charges you for any monthly payments due after you leave, you can claim up to £300 Sky account credit (capped at the amount you are charged for those monthly payments (e.g. excluding outstanding call charges). To claim, you must have paid those in full and send us proof of your payment within 90 days of your Sky services being activated. \n\nOffer available to UK residential customers only - excludes the Channel Islands, Isle of Man and ROI. No cash alternative available. Offer invalidated if you cancel your Sky services before your Sky account credit is processed.";
  var LEGAL_COPY_3 = "Requires Sky Stream or Sky Glass. Sky Essential TV subscription: £15 pm. 24-month minimum term. Prices may vary during this term. Standard price applies after 24 months (currently £21pm) OR 31-day rolling subscription. Includes Sky Atlantic, Sky Showcase, Sky Sports News, Sky Sports Mix, Sky Sports Racing, Netflix Standard with ads and discovery+ Basic. All content on Sky Stream and Sky Glass is streamed via broadband, minimum speed of 30Mbps recommended. 18+.UK, CI, IoM only";
  var MODAL_TITLE = "";

  var isApplying = false;
  var isOpen = false;
  var lastActiveEl = null;
  var removeKeydown = null;
  var lockedScrollY = 0;
  var savedBodyPaddingRight = "";
  var savedHtmlScrollBehavior = "";
  var savedBodyScrollBehavior = "";
  var currentModalSlug = "";
  var currentModalHeading = "";
  var mo = null;

  function qs(sel, root) {
    return (root || document).querySelector(sel);
  }

  function qsa(sel, root) {
    return (root || document).querySelectorAll(sel);
  }

  function text(el) {
    return el && el.textContent ? el.textContent.replace(/\s+/g, " ").replace(/^\s+|\s+$/g, "") : "";
  }

  function slugify(str) {
    return (str || "")
      .toLowerCase()
      .replace(/&/g, "and")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  function waitFor(predicate, cb, timeout) {
    var start = Date.now();
    (function tick() {
      if (predicate()) return cb();
      if (Date.now() - start > (timeout || 8000)) return;
      requestAnimationFrame(tick);
    })();
  }

  function isVisible(el) {
    return !!(el && (el.offsetWidth || el.offsetHeight || el.getClientRects().length));
  }

  function getFocusable(container) {
    var nodes = qsa(
      'a[href],area[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),iframe,[tabindex]:not([tabindex="-1"]),[contenteditable="true"]',
      container
    );
    var out = [];
    var i;

    for (i = 0; i < nodes.length; i++) {
      if (!isVisible(nodes[i])) continue;
      if (nodes[i].getAttribute("aria-hidden") === "true") continue;
      out.push(nodes[i]);
    }

    return out;
  }

  function getOuterPadding() {
    return window.innerWidth < 600 ? "16px" : "24px";
  }

  function getInnerPaddingX() {
    return window.innerWidth < 600 ? "16px" : "32px";
  }

  function getInnerPaddingBottom() {
    return window.innerWidth < 600 ? "16px" : "24px";
  }

  function getHeaderTopPadding() {
    return window.innerWidth < 600 ? "16px" : "20px";
  }

  function getHeaderBottomGap() {
    return window.innerWidth < 600 ? "12px" : "16px";
  }

  function getModalContentFontSize() {
    return window.innerWidth < 600 ? "16px" : "14px";
  }

  function getModalTitleFontSize() {
    return window.innerWidth < 600 ? "18px" : "20px";
  }

  function updateModalStyles() {
    var modal = qs("#optz-legal-modal");
    var inner = qs("#optz-legal-inner");
    var header = qs("#optz-legal-header");
    var content = qs("#optz-legal-content");
    var closeBtn = qs("#optz-legal-close");

    if (modal) {
      modal.style.padding = getOuterPadding();
    }

    if (inner) {
      inner.style.maxWidth = "1044px";
      inner.style.maxHeight = "calc(100vh - " + (window.innerWidth < 600 ? "32px" : "48px") + ")";
      inner.style.borderRadius = window.innerWidth < 600 ? "8px" : "12px";
    }

    if (header) {
      header.style.padding =
        getHeaderTopPadding() + " " + getInnerPaddingX() + " 0 " + getInnerPaddingX();
      header.style.gap = getHeaderBottomGap();
    }

    if (content) {
      content.style.fontSize = getModalContentFontSize();
      content.style.lineHeight = "1.6";
      content.style.padding =
        getHeaderBottomGap() + " " + getInnerPaddingX() + " " + getInnerPaddingBottom() + " " + getInnerPaddingX();
    }

    if (closeBtn) {
      closeBtn.style.width = "32px";
      closeBtn.style.height = "32px";
      closeBtn.style.minWidth = "32px";
      closeBtn.style.borderRadius = "4px";
    }
  }

  function lockScroll() {
    var docEl = document.documentElement;

    lockedScrollY = window.pageYOffset || docEl.scrollTop || document.body.scrollTop || 0;

    savedHtmlScrollBehavior = docEl.style.scrollBehavior || "";
    savedBodyScrollBehavior = document.body.style.scrollBehavior || "";
    docEl.style.scrollBehavior = "auto";
    document.body.style.scrollBehavior = "auto";

    savedBodyPaddingRight = document.body.style.paddingRight || "";

    var scrollBarWidth = window.innerWidth - docEl.clientWidth;
    if (scrollBarWidth > 0) {
      document.body.style.paddingRight = scrollBarWidth + "px";
    }

    document.body.style.position = "fixed";
    document.body.style.top = (-lockedScrollY) + "px";
    document.body.style.left = "0";
    document.body.style.right = "0";
    document.body.style.width = "100%";
    document.body.style.overflow = "hidden";
  }

  function unlockScroll() {
    document.body.style.position = "";
    document.body.style.top = "";
    document.body.style.left = "";
    document.body.style.right = "";
    document.body.style.width = "";
    document.body.style.overflow = "";
    document.body.style.paddingRight = savedBodyPaddingRight;

    window.scrollTo(0, lockedScrollY);

    document.documentElement.style.scrollBehavior = savedHtmlScrollBehavior;
    document.body.style.scrollBehavior = savedBodyScrollBehavior;
  }

  function focusFirstInModal() {
    var modal = qs("#optz-legal-inner");
    if (!modal) return;

    var focusables = getFocusable(modal);
    if (focusables.length) {
      focusables[0].focus();
    } else {
      modal.setAttribute("tabindex", "-1");
      modal.focus();
    }
  }

  function trapKeydown(e) {
    if (!isOpen) return;

    e = e || window.event;
    var key = e.key || e.keyCode;

    if (key === "Escape" || key === "Esc" || key === 27) {
      if (e.preventDefault) e.preventDefault();
      closeModal();
      return;
    }

    if (!(key === "Tab" || key === 9)) return;

    var modal = qs("#optz-legal-inner");
    if (!modal) return;

    var focusables = getFocusable(modal);
    if (!focusables.length) {
      if (e.preventDefault) e.preventDefault();
      return;
    }

    var first = focusables[0];
    var last = focusables[focusables.length - 1];
    var active = document.activeElement;
    var shift = !!e.shiftKey;

    if (!modal.contains(active)) {
      if (e.preventDefault) e.preventDefault();
      first.focus();
      return;
    }

    if (shift && active === first) {
      if (e.preventDefault) e.preventDefault();
      last.focus();
      return;
    }

    if (!shift && active === last) {
      if (e.preventDefault) e.preventDefault();
      first.focus();
      return;
    }
  }

  function setModalTracking(slug, heading, state) {
    var modal = qs("#optz-legal-modal");
    var inner = qs("#optz-legal-inner");
    var closeBtn = qs("#optz-legal-close");

    if (!modal || !inner || !closeBtn) return;

    modal.setAttribute("data-tracking-description", "modal:package-section-card-legals");
    modal.setAttribute("data-tracking-label", "modal:package-section-card-" + slug + "-legals");
    modal.setAttribute("data-tracking-location", "Page");
    modal.setAttribute("data-tracking-text", heading + " legals modal");
    modal.setAttribute("data-tracking-state", state || "closed");

    inner.setAttribute("data-tracking-description", "dialog:package-section-card-legals");
    inner.setAttribute("data-tracking-label", "dialog:package-section-card-" + slug + "-legals");
    inner.setAttribute("data-tracking-location", "Page");
    inner.setAttribute("data-tracking-text", heading + " legals dialog");

    closeBtn.setAttribute("data-tracking-description", "close:package-section-card-legals-modal");
    closeBtn.setAttribute("data-tracking-label", "close:package-section-card-" + slug + "-legals-modal");
    closeBtn.setAttribute("data-tracking-location", "Page");
    closeBtn.setAttribute("data-tracking-text", "Close");
  }

  function ensureModal() {
    if (qs("#optz-legal-modal")) {
      updateModalStyles();
      return;
    }

    var overlay = document.createElement("div");
    overlay.id = "optz-legal-overlay";
    overlay.style.cssText =
      "position:fixed;" +
      "top:0;" +
      "left:0;" +
      "width:100%;" +
      "height:100%;" +
      "background:rgba(0,0,0,0.6);" +
      "z-index:9999;" +
      "display:none;";

    var modal = document.createElement("div");
    modal.id = "optz-legal-modal";
    modal.setAttribute("role", "presentation");
    modal.setAttribute("data-tracking-state", "closed");
    modal.style.cssText =
      "position:fixed;" +
      "top:0;" +
      "left:0;" +
      "width:100%;" +
      "height:100%;" +
      "z-index:10000;" +
      "display:none;" +
      "overflow-y:auto;" +
      "box-sizing:border-box;" +
      "padding:" + getOuterPadding() + ";";

    var inner = document.createElement("div");
    inner.id = "optz-legal-inner";
    inner.setAttribute("role", "dialog");
    inner.setAttribute("aria-modal", "true");
    inner.setAttribute("aria-labelledby", "optz-legal-title");
    inner.style.cssText =
      "background:#fff;" +
      "position:relative;" +
      "max-width:1044px;" +
      "margin:0 auto;" +
      "display:flex;" +
      "flex-direction:column;" +
      "max-height:calc(100vh - 48px);" +
      "border-radius:12px;" +
      "box-shadow:0 10px 15px rgba(0,0,0,0.2);";

    var header = document.createElement("div");
    header.id = "optz-legal-header";
    header.style.cssText =
      "display:flex;" +
      "align-items:flex-start;" +
      "justify-content:space-between;" +
      "gap:" + getHeaderBottomGap() + ";" +
      "padding:" + getHeaderTopPadding() + " " + getInnerPaddingX() + " 0 " + getInnerPaddingX() + ";";

    var title = document.createElement("div");
    title.id = "optz-legal-title";
    title.textContent = MODAL_TITLE;
    title.style.cssText =
      "font-size:" + getModalTitleFontSize() + ";" +
      "font-weight:600;" +
      "line-height:1.3;" +
      "min-height:32px;" +
      "display:flex;" +
      "align-items:center;";

    var closeBtn = document.createElement("button");
    closeBtn.type = "button";
    closeBtn.id = "optz-legal-close";
    closeBtn.setAttribute("aria-label", "Close");
    closeBtn.innerHTML = "×";
    closeBtn.style.cssText =
      "cursor:pointer;" +
      "font-size:20px;" +
      "line-height:1;" +
      "border:1px solid rgb(153,153,153);" +
      "background:transparent;" +
      "width:32px;" +
      "height:32px;" +
      "min-width:32px;" +
      "display:flex;" +
      "align-items:center;" +
      "justify-content:center;" +
      "border-radius:4px;" +
      "padding:0;" +
      "color:inherit;" +
      "flex-shrink:0;";

    var content = document.createElement("div");
    content.id = "optz-legal-content";
    content.style.cssText =
      "white-space:pre-wrap;" +
      "font-size:" + getModalContentFontSize() + ";" +
      "line-height:1.6;" +
      "overflow-y:auto;" +
      "-webkit-overflow-scrolling:touch;" +
      "padding:" + getHeaderBottomGap() + " " + getInnerPaddingX() + " " + getInnerPaddingBottom() + " " + getInnerPaddingX() + ";";

    header.appendChild(title);
    header.appendChild(closeBtn);
    inner.appendChild(header);
    inner.appendChild(content);
    modal.appendChild(inner);

    overlay.onclick = function (e) {
      if (e && e.target === overlay) closeModal();
    };

    modal.onclick = function (e) {
      if (e && e.target === modal) closeModal();
    };

    closeBtn.onclick = function (e) {
      if (e && e.preventDefault) e.preventDefault();
      closeModal();
      return false;
    };

    document.body.appendChild(overlay);
    document.body.appendChild(modal);

    if (!document.getElementById("optz-modal-close-style")) {
      var st = document.createElement("style");
      st.id = "optz-modal-close-style";
      st.textContent =
        "#optz-legal-close:hover{" +
          "background:rgb(243,245,255);" +
        "}" +
        "#optz-legal-close:focus{" +
          "background:rgb(243,245,255);" +
          "outline:none;" +
        "}" +
        "#optz-legal-inner p{" +
          "margin:0 0 16px;" +
        "}" +
        "#optz-legal-inner p:last-child{" +
          "margin-bottom:0;" +
        "}";
      document.head.appendChild(st);
    }

    setModalTracking("generic", "Legals", "closed");
    updateModalStyles();
  }

  function openModal(copy, openerEl, slug, heading) {
    ensureModal();

    lastActiveEl = openerEl || document.activeElement;
    currentModalSlug = slug || "generic";
    currentModalHeading = heading || "Legals";

    var overlay = qs("#optz-legal-overlay");
    var modal = qs("#optz-legal-modal");
    var content = qs("#optz-legal-content");
    var title = qs("#optz-legal-title");

    if (title) title.textContent = MODAL_TITLE;
    if (content) content.textContent = copy || "";

    setModalTracking(currentModalSlug, currentModalHeading, "open");
    updateModalStyles();

    overlay.style.display = "block";
    modal.style.display = "block";

    lockScroll();

    isOpen = true;

    if (!removeKeydown) {
      var handler = function (ev) {
        trapKeydown(ev);
      };
      document.addEventListener("keydown", handler, true);
      removeKeydown = function () {
        document.removeEventListener("keydown", handler, true);
      };
    }

    focusFirstInModal();
  }

  function closeModal() {
    var overlay = qs("#optz-legal-overlay");
    var modal = qs("#optz-legal-modal");

    if (!overlay || !modal) return;

    overlay.style.display = "none";
    modal.style.display = "none";

    setModalTracking(currentModalSlug || "generic", currentModalHeading || "Legals", "closed");

    isOpen = false;

    if (removeKeydown) {
      removeKeydown();
      removeKeydown = null;
    }

    unlockScroll();

    if (lastActiveEl && lastActiveEl.focus) {
      try {
        lastActiveEl.focus();
      } catch (e) {}
    }

    lastActiveEl = null;
  }

  function getCardMeta(card) {
    var heading = text(qs("h3", card));
    var slug = slugify(heading);
    var copy = "";

    if (heading.indexOf("300Mbps Full Fibre Broadband") > -1) {
      copy = LEGAL_COPY_2;
    } else if (heading === "Sky Essential TV") {
      copy = LEGAL_COPY_3;
    } else if (heading.indexOf("Sky Ultimate TV") > -1) {
      copy = LEGAL_COPY_1;
    }

    return {
      heading: heading,
      slug: slug,
      copy: copy
    };
  }

  function addLegalLinks() {
    var cards = qsa('[data-test-id="package-section-card"]');
    var i;

    for (i = 0; i < cards.length; i++) {
      var card = cards[i];
      var meta = getCardMeta(card);
      var legalWrapper = qs(".legals__Wrapper-sc-1k8dcp4-0", card);
      var legalTextEl = legalWrapper ? qs('[data-skyui-core^="Text@"]', legalWrapper) : null;

      if (!legalTextEl || !meta.copy || !meta.slug) continue;
      if (qs('[data-optz-legal-trigger="true"]', legalTextEl)) continue;

      var link = document.createElement("a");
      link.href = "#";
      link.setAttribute("data-optz-legal-trigger", "true");
      link.setAttribute("data-tracking-description", "link:package-section-card-legals");
      link.setAttribute("data-tracking-label", "link:package-section-card-" + meta.slug + "-see-all-legals");
      link.setAttribute("data-tracking-location", "Page");
      link.setAttribute("data-tracking-text", "See all legals");
      link.setAttribute("data-tracking-url", "#");
      link.style.cssText =
        "margin-left:4px;" +
        "text-decoration:underline;" +
        "cursor:pointer;";
      link.textContent = "See all legals";

      (function (cardMeta, triggerEl) {
        triggerEl.onclick = function (e) {
          if (e && e.preventDefault) e.preventDefault();
          openModal(cardMeta.copy, triggerEl, cardMeta.slug, cardMeta.heading);
          return false;
        };
      })(meta, link);

      legalTextEl.appendChild(document.createTextNode(" "));
      legalTextEl.appendChild(link);
    }
  }

  function addLearnMoreButtons() {
    var cards = document.querySelectorAll('[data-test-id="package-section-card"]');
    var i;

    if (!cards || !cards.length) return false;

    for (i = 0; i < cards.length; i++) {
      var card = cards[i];
      var learnMore = card.querySelector(
        'a[data-tracking-text="Learn more"], a[aria-label^="Learn more"]'
      );
      var getStarted = card.querySelector(
        'a[data-tracking-text="Get started"], a[aria-label^="Get started"]'
      );

      if (!learnMore || !getStarted) continue;
      if (card.getAttribute("data-optly-lm-button") === "1") continue;

      var learnMoreColor = window.getComputedStyle(learnMore).color;
      var learnMoreBtn = getStarted.cloneNode(true);
      var attrs = [
        "aria-label",
        "data-tracking-description",
        "data-tracking-label",
        "data-tracking-location",
        "data-tracking-text",
        "data-tracking-url"
      ];
      var j;

      learnMoreBtn.textContent = "Learn more";

      if (learnMore.getAttribute("href")) {
        learnMoreBtn.setAttribute("href", learnMore.getAttribute("href"));
      }

      for (j = 0; j < attrs.length; j++) {
        var v = learnMore.getAttribute(attrs[j]);
        if (v) learnMoreBtn.setAttribute(attrs[j], v);
      }

      getStarted.insertAdjacentElement("afterend", learnMoreBtn);
      learnMore.style.display = "none";

      learnMoreBtn.style.marginTop = "12px";
      learnMoreBtn.style.background = "transparent";
      learnMoreBtn.style.backgroundColor = "transparent";
      learnMoreBtn.style.backgroundImage = "none";
      learnMoreBtn.style.boxShadow = "none";
      learnMoreBtn.style.color = learnMoreColor;
      learnMoreBtn.style.border = "1px solid " + learnMoreColor;

      if (!document.getElementById("optly-ghost-btn-style")) {
        var st = document.createElement("style");
        st.id = "optly-ghost-btn-style";
        st.textContent =
          '[data-test-id="package-section-card"] a[data-tracking-text="Learn more"]{' +
            "background:transparent !important;" +
            "background-image:none !important;" +
            "box-shadow:none !important;" +
          "}" +
          '[data-test-id="package-section-card"] a[data-tracking-text="Learn more"]:hover,' +
          '[data-test-id="package-section-card"] a[data-tracking-text="Learn more"]:focus{' +
            "background:transparent !important;" +
            "background-image:none !important;" +
            "box-shadow:none !important;" +
          "}";
        document.head.appendChild(st);
      }

      card.setAttribute("data-optly-lm-button", "1");
    }

    return true;
  }

  function resetLearnMoreFlagsIfNeeded() {
    var cards = document.querySelectorAll('[data-test-id="package-section-card"]');
    var i;

    for (i = 0; i < cards.length; i++) {
      var c = cards[i];
      var btns = c.querySelectorAll('a[data-tracking-text="Learn more"]');
      var hasVisibleButton = false;
      var j;

      for (j = 0; j < btns.length; j++) {
        if (btns[j].style.display !== "none") {
          hasVisibleButton = true;
          break;
        }
      }

      if (!hasVisibleButton) {
        c.setAttribute("data-optly-lm-button", "0");
      }
    }
  }

  function applyAll() {
    if (isApplying) return;
    isApplying = true;

    if (mo) mo.disconnect();

    try {
      ensureModal();
      resetLearnMoreFlagsIfNeeded();
      addLearnMoreButtons();
      addLegalLinks();
    } catch (e) {}

    isApplying = false;

    if (mo) {
      mo.observe(document.body, { childList: true, subtree: true });
    }
  }

  window.addEventListener("resize", function () {
    updateModalStyles();
  });

  waitFor(function () {
    return (
      document.querySelectorAll('[data-test-id="package-section-card"]').length >= 3 &&
      document.querySelector('a[data-tracking-text="Get started"], a[aria-label^="Get started"]')
    );
  }, function () {
    ensureModal();
    applyAll();

    mo = new MutationObserver(function () {
      applyAll();
    });

    mo.observe(document.body, { childList: true, subtree: true });
  }, 10000);
})();
