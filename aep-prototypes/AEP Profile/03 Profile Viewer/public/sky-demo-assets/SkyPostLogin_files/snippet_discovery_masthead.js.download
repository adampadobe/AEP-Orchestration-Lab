"4770005814870016"], "weightDistributions": null, "decisionMetadata": null, "concluded": false}, {"changes": null, "id": "4837611921997824", "name": "EXP-915 | ROI TV Discovery Page - Deal Cards Optimisations ", "commitId": "6130226453807104", "groupId": null, "holdback": 0, "activation": {}, "integrationSettings": {}, "integrationStringVersion": 2, "experiments": [{"audienceIds": ["and", "24627820073"], "audienceName": "QA: Cookie", "changes": null, "id": "5157635740139520", "integrationSettings": null, "variations": [{"id": "6089459563757568", "name": "Original", "actions": []}, {"id": "5737547324719104", "name": "Variation 1", "actions": [{"viewId": "5046864708370432", "changes": [{"css": {}, "isOpalManaged": false, "dependencies": [], "name": "", "attributes": {"remove": true}, "type": "attribute", "id": "BDEAC642-3317-4FC5-AE82-13A0434E27D2", "selector": "div:nth-of-type(2) > div > [data-skyui-core='Highlight@13.1.1']"}, {"css": {}, "isOpalManaged": false, "dependencies": [], "name": "", "attributes": {"html": "Best value"}, "type": "attribute", "id": "8E311E02-1B46-46FC-BCCF-DF834D6FB817", "selector": "div:nth-of-type(1) > div > [data-skyui-core='Highlight@13.1.1']"}, {"operator": "after", "isOpalManaged": false, "dependencies": [], "name": "Duplicate of li", "value": "<li class=\"list-item__ListItemWrapper-sc-1em5na7-0 cTEqIL\" id=\"optly-duplicate-7EC66796\"><span class=\"list-item__IconWrapper-sc-1em5na7-1 cYVlBI\"><svg aria-hidden=\"true\" data-skyui-core=\"Icon@13.1.1\" viewBox=\"0 0 32 32\" class=\"icon__Svg-sc-wdtbmy-0 egOLRB\"><g><path d=\"M26.293 8.707a1 1 0 0 1 0 1.414L13 23.414a.999.999 0 0 1-1.414 0l-6.293-6.293a.999.999 0 0 1 0-1.414L6 15l6.293 6.293L25.586 8l.707.707Z\" fill-rule=\"evenodd\" clip-rule=\"evenodd\"></path></g></svg></span>110+ channels, including Sky Atlantic, Sky One, Sky Docs, Sky Witness and more.</li>", "attributes": {}, "type": "append", "id": "43A34E99-A500-45E0-8342-979B905093D7", "selector": "div:nth-of-type(1) > div > div[