(function () {
  var utils = window.optimizely.get('utils');

  var CONFIG = {
    anchor: '[data-test-id="packages-section"]',
    desktopVideo: 'https://assets.contentstack.io/v3/assets/blt143e20b03d72047e/bltf00ebe92f04ab95b/6a3cf784cf4d2c6455ed79b0/Sky_Cinema_Top_Sizzle_Family_2.0_Desktop_GFX_Master_(1).mp4',
    mobileVideo: 'https://assets.contentstack.io/v3/assets/blt143e20b03d72047e/blt34d84f4400fe26c4/6a3cf784faa8979057b71042/Sky_Cinema_Top_Sizzle_Family_2.0_Mobile_GFX_Master.mp4',
    
  };

  function isMobile() {
    return window.matchMedia('(max-width: 768px)').matches;
  }

  function getMedia() {
    return isMobile()
      ? {
          video: CONFIG.mobileVideo,
          poster: CONFIG.mobileFallback
        }
      : {
          video: CONFIG.desktopVideo,
          poster: CONFIG.desktopFallback
        };
  }

  function buildBanner() {
    var wrapper = document.createElement('div');
    wrapper.setAttribute('data-optly-video', 'true');
    wrapper.style.width = '100%';

    var video = document.createElement('video');
    video.autoplay = true;
    video.muted = true;
    video.loop = true;
    video.playsInline = true;
    video.style.width = '100%';

    var source = document.createElement('source');
    video.appendChild(source);

    wrapper.appendChild(video);

    return wrapper;
  }

  function updateBanner(banner) {
    var media = getMedia();
    var video = banner.querySelector('video');
    var source = banner.querySelector('source');

    if (!video || !source) return;

    // update source only when changed
    if (source.src !== media.video) {
      source.src = media.video;
      video.load();
      video.play().catch(function () {});
    }

    video.setAttribute('poster', media.poster);
  }

  function inject() {
    var anchor = document.querySelector(CONFIG.anchor);
    if (!anchor) return;

    var existing = document.querySelector('[data-optly-video="true"]');

    if (!existing) {
      var banner = buildBanner();
      anchor.parentNode.insertBefore(banner, anchor);
      updateBanner(banner);
    } else {
      updateBanner(existing);
    }
  }

  
  utils.observeSelector(CONFIG.anchor, inject);

  
  setInterval(inject, 1000);

  
  window.addEventListener('resize', function () {
    var banner = document.querySelector('[data-optly-video="true"]');
    if (banner) {
      updateBanner(banner);
    }
  });
})();
