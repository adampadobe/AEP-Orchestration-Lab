    color: #ffffff;\n    text-decoration: none;\n    line-height: 1.5625em;\n    padding: .5em 2.803em;\n    text-align: center;\n    position: relative;\n    z-index: 9999999999999999; \n}\n\n.QMH-anchored-aval:focus {\n    outline: 1px solid black;\n}\n\n.QMH-p {\n    width: 90%; /* Dynamic width */\n    max-width: 26em; /* Limit max width */\n    text-align: center;\n    color: #0a5b0c;\n    line-height: 1.5em;\n    font-weight: 400;\n    font-size: 16px;\n    margin: 1em auto; /* Center horizontally and add spacing */\n}\n.QMH-anchored-aval-svg {\n position: relative;\n top: 2px;\n margin: 0 0 0 10px;\n fill: #ffffff;\n float: right;\n}\n</style>\n<div>\n<p class=\"QMH-p\" style=\"color: #0a5b0c;\">Live Chat is currently closed, please come back within our operating hours:</p>\n<p class=\"QMH-p\" style=\"color: #0a5b0c;\">Monday to Friday, 8:00am to 6:00pm<br/>Saturday, 9:00am to 5:00pm<br/>Sundays, 10:00am to 4:00pm</p>\n<p style=\"text-align: center;\">Alternatively you can contact us using our <a style=\"TEXT-DECORATION: underline\" href=\"https://help.quotemehappy.com/connect-contact-form/other\">email form</a>.</p>\n</div>",d:"<span></span>",ralt:null,balt:null,ahalt:null,dalt:null,renderAsHTML:true}}};},xmlData:{businessSchedules:function(){return{"MonToFRI-1700to2000-schedule":Schedule.createSchedule("MonToFRI-1700to2000-schedule",null,null,61200000,71999000,[1,2,3,4,5],"CET"),"Sat-0900to1300-schedule":Schedule.createSchedule("Sat-0900to1300-schedule",null,null,32400000,46799000,[6],"CET")};},dfvs:function(){return{"CartDataPass":DFV.c("CartDataPass",function(){var agentDisplay="\n";if("undefined"!==typeof(nuanceData)){var agentDisplay="\n";if(nuanceData.CurrentCartValue!=""){agentDisplay+="<b>Total Cart Value:</b> "+nuanceData.CurrentCartValue+"\n";}
if(nuanceData.AppliedDiscounts!=""){agentDisplay+="<b>Discounts Applied:</b>"+nuanceData.AppliedDiscounts+"\n";}
if(typeof nuanceData.quotesInCart!=="undefined"){for(var i=0;i<nuanceData.quotesInCart.length;i++){agentDisplay+="<b>Quotes in cart "+(i+1)+":</b> ";if(nuanceData.quotesInCart[i].quoteName){agentDisplay+="<b>Name:</b> "+nuanceData.quotesInCart[i].quoteName+"\n";}
if(nuanceData.quotesInCart[i].quoteCategory){agentDisplay+="<b>Category:</b> "+nuanceData.quotesInCart[i].quoteCategory+"\n";}
if(nuanceData.quotesInCart[i].quoteCompletion){agentDisplay+="<b>Completion:</b> "+nuanceData.quotesInCart[i].quoteCompletion+"\n";}
