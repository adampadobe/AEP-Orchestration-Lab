osition: absolute;\n    margin-bottom: -44px;\n    bottom: 98px;\n    right: 72%;\n    border-top-right-radius: 5px;\n    border-top-left-radius: 5px;\n  \n}\n.sb4:before {\n    content: \"\";\n    width: 0px;\n    height: 0px;\n    position: absolute;\n    border-left: 23px solid transparent;\n    border-right: 8px solid rgb(255, 216, 0);\n    border-top: 39px solid rgb(255, 216, 0);\n    border-bottom: 23px solid transparent;\n    right: 0px;\n    bottom: -18px;\n    z-index: 99;\n\n}\n\n\n\n</style>\n\n\n\n<div class=\"box sb4\">Need Help?<br>\n<span>Chat to one of our dedicated consultants<span></div>\n\n<button class=\"aviva-anchored-aval\" href=\"#\" aria-label=\"Click to chat\" role=\"button\">Live Chat\n  <span class='aviva-anchored-aval-badge'></span>\n    <span class=\"aviva-anchored-aval-svg\" alt=\"\" role=\"img\" aria-hidden=\"true\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 22.54 22.54\" width=\"22px\" height=\"22px\">\n        <path class=\"cls-1\" d=\"M14.34,12.17V6.91a.76.76,0,0,0-.75-.75H6.08a.75.75,0,0,0-.75.75v5.26a.74.74,0,0,0,.75.75h.2l0,1.38,1.35-1.38h6A.75.75,0,0,0,14.34,12.17Z\"/>\n        <path class=\"cls-1\" d=\"M15.82,8.44h-.73v4.48a.75.75,0,0,1-.75.75H7.93v.78a.76.76,0,0,0,.75.75h5.6l1.36,1.38,0-1.38h.2a.76.76,0,0,0,.75-.75V9.19A.75.75,0,0,0,15.82,8.44Z\"/>\n        <path class=\"cls-1\" d=\"M11.27,0A11.27,11.27,0,1,0,22.54,11.27,11.28,11.28,0,0,0,11.27,0Zm0,21A9.77,9.77,0,1,1,21,11.27,9.78,9.78,0,0,1,11.27,21Z\"/>\n      </svg>\n   </span>\n</button>",b:"<style></style>",ah:"<style></style>",d:"<style></style>",ralt:null,balt:null,ahalt:null,dalt:null,renderAsHTML:true},33001736:{id:33001736,name:"AV-UKD-AZ_Claims-Text",r:"<button class=\"a-button a-button--tertiary\"><span class=\"a-button__inner\">Use our live chat</span></button>",b:"<button class=\"a-button a-button--tertiary\" disabled><span class=\"a-button__inner\">Use our live chat</span></button>",ah:"<button class=\"a-button a-button--tertiary\" disabled><span class=\"a-button__inner\">Use our live chat</span></button>",d:"<button class=\"a-button a-button--tertiary\" disabled><span class=\"a-button__inner\">Use our live chat</span></button>",ralt:null,balt:null,ahalt:null,dalt:null,renderAsHTML:true},33001738:{id:33001738,name:"AV-UKD-AZ_Claims-C2C",r:"<button class=\"a-button\">Live chat</button>",b:"<button class=\"a-button\" disabled>Live chat</button>",ah:"<button class=\"a-button\" disabled>Live chat</button>",d:"<button class=\"a-button\" disabled>Live chat</button>",ralt:null,balt:null,ahalt:null,dalt:null,renderAsHTML:true},33001739:{id:33001739,name:"AV-UKD-AZ_FAQ-Needhelp",r:"<style>\n.aviva-button-available {\n    background: #ffd900;\n    border-color: #ffd900;\n    border-style: solid;\n    color: #004fb6;\n    display: inline-block;\n    width: 140px;\n    height: 50px;\n    appearance: none;\n    border: 1px solid #737373;\n    border-width: 0;\n    border-radius: 0.25em;\n    cursor: pointer;\n    font-size: 16px;\n    font-weight: 700;\n    margin: 0 0 10px 0px;\n    padding: 0.875em 0.875em;\n    position: relative;\n    text-align: center;\n    text-decoration: none;\n    user-select: none;\n    vertical-align: middle;\n    transition: background-color .35s, border-color .35s, color .35s;\n}\n.aviva-button-available:hover {\n    background: #004fb6;\n    border-color: #004fb6;\n    color: #fff;\n}\n.aviva-button-available:active {\n    background-color: #002185;\n    border-color: #002185;\n    color: #fff;\n}\n.aviva-fixed-available {\n   cursor: default !important;\n}\n.aviva-fixed p {\n    margin: 0.625em 0;\n}\n</style>\n\n<div class=\"aviva-fixed\">\n<p>If you require support, you can use Aviva's Live Chat service. Simply click the button bellow to start a chat, and we'll connect you with one of the team.</p>\n<a class=\"aviva-button-available\" href=\"#\">Get in touch</a>\n</div>",b:"<style aria-hidden=\"true\">\n       span.aviva-fixed-busy {\n         cursor: default !important;\n         outline: none;\n       }\n       div.aviva-fixed-busy {\n         margin-inline: 15px;\n         padding-bottom: 20px;\n         margin-top: 10px;\n         margin-bottom: 10px;\n       }\n       a.aviva-fixed-href {\n         border-bottom: 1px solid #ccc;\n         border-bottom-style: solid;\n         color: #004fb6;\n         font-size: 16px;\n         font-weight: 700;\n         line-height: 1.5em;\n         margin-top: 0px;  \n       }\n       a.aviva-fixed-href:hover {\n         border-bottom-color: #004fb6;\n         border-bottom-style: solid;\n       }\n</style>\n<div class=\"aviva-fixed-busy\">\n<span class=\"aviva-fixed-busy\">All our chat agents are currently busy supporting other customers. We'll keep checking the team’s availability for you and update this message when we're able to connect you.</span></div>",ah:"<style aria-hidden=\"true\">\n       span.aviva-fixed-closed {\n         cursor: default !important;\n         outline: none;\n       }\n       div.aviva-fixed-closed {\n         margin-inline: 15px;\n         padding-bottom: 20px;\n         margin-top: 10px;\n         margin-bottom: 10px;\n       }\n       p.aviva-fixed-closed1 {\n         margin-top: 10px;\n         margin-bottom: 10px;\n       }\n       p.aviva-fixed-closed2 {\n         margin-top: 20px;\n         margin-bottom: 10px;\n         font-weight: 700;\n       }\n       a.aviva-fixed-href {\n         border-bottom: 1px solid #ccc;\n         border-bottom-style: solid;\n         color: #004fb6;\n         font-size: 16px;\n         font-weight: 700;\n         line-height: 1.5em;\n         margin-top: 0px;  \n       }\n       a.aviva-fixed-href:hover {\n         border-bottom-color: #004fb6;\n         border-bottom-style: solid;\n       }\n\n</style>\n\n<div class=\"aviva-fixed-closed\">\n\n<p class=\"aviva-fixed-closed1\">Our Live Chat service is currently closed. You can discuss changes and queries with our chat team within our opening hours: </p>\n\n<p class=\"aviva-fixed-closed2\">Opening times</p>\n\n<p class=\"aviva-fixed-closed1\">Monday - Friday - 07:00am - 20:00pm</p>\n\n<p class=\"aviva-fixed-closed1\">Saturday - 08:00am - 17:00pm</p>\n\n<p class=\"aviva-fixed-closed1\">Sunday - 8:00am - 16:00pm</p>\n\n<p class=\"aviva-fixed-closed1\">Opening times may vary on bank holidays.</p></div>",d:"<span></span>",ralt:null,balt:null,ahalt:null,dalt:null,renderAsHTML:true},33001743:{id:33001743,name:"AV-UKD-AZ_MTA-Desktop",r:"<style>\n.aviva-fixed {\n padding: 15px;\n}\n.aviva-fixed-available {\ncursor: default !important;\n}\n.aviva-button-available {\n    background: #ffd900;\n    border-color: #ffd900;\n    border-style: solid;\n    color: #004fb6;\n    display: inline-block;\n    width: auto;\n    appearance: none;\n    border: 1px solid #737373;\n    border-width: 0;\n    border-radius: 0.25em;\n    cursor: pointer;\n    font-size: 1em;\n    font-weight: 700;\n    line-height: 1.5625em;\n    margin: 0;\n    min-width: 6.25em;\n    padding: 0.875em 1.875em;\n    position: relative;\n    text-align: center;\n    text-decoration: none;\n    user-select: none;\n    vertical-align: middle;\n    transition: background-color .35s,border-color .35s,color .35s;\n}\n\n.aviva-button-available:hover {\n    background: #004fb6;\n    border-color: #004fb6;\n    color: #fff;\n}\n\n.aviva-button-available:active {\n    background-color: #002185;\n    border-color: #002185;\n    color: #fff;\n}\n.aviva-fixed p {\nmargin: 0.625em 0;\n}\n</style>\n\n<div class=\"aviva-fixed aviva-fixed-available\">\n<p class=\"aviva-fixed-available\"><u>Live Chat opening times:</u><br/><br/>\nMonday - Friday - 07:00 - 20:00<br/>\nSaturday - 08:00 - 17:00<br/>\nSunday - 08:00 - 16:00<br/><br/>\nOpening times may vary on bank holidays.</p>\n<a class=\"aviva-button-available\" href=\"#\"\">Start a Live Chat</a>\n</div>",b:"<style>\n.aviva-fixed {\n  padding: 15px;\n}\n.aviva-button-disabled {\n    background-color: #ccc;\n    border-color: #ccc;\n    color: #535353;\n    box-shadow: none;\n    cursor: default;\n    pointer-events: none;\n    appearance: none;\n    border: 1px solid #737373;\n    border-width: 0;\n    border-radius: 0.25em;\n    font-size: 1em;\n    font-weight: 700;\n    line-height: 1.5625em;\n    margin: 0;\n    min-width: 6.25em;\n    padding: 0.875em 1.875em;\n    position: relative;\n    text-align: center;\n    text-decoration: none;\n    user-select: none;\n    vertical-align: middle;\n    display: inline-block;\n    width: auto;\n}\n.aviva-fixed p {\nmargin: 0.625em 0;\n}\n</style>\n\n<div class=\"aviva-fixed\">\n<p>\nWe're open but all our chat agents are currently busy supporting other customers.\n</p>\n<p>\nWe'll keep checking the team's availability for you and update this message when we're able to connect you.\n</p>\n<a class=\"aviva-button-disabled\" href=\"#\" aria-disabled=\"true\">Start a Live Chat</a>\n</div>",ah:"<style>\n.aviva-fixed {\n  padding: 15px;\n}\n.aviva-button-disabled {\n    background-color: #ccc;\n    border-color: #ccc;\n    color: #535353;\n    box-shadow: none;\n    cursor: default;\n    pointer-events: none;\n    appearance: none;\n    border: 1px solid #737373;\n    border-width: 0;\n    border-radius: 0.25em;\n    font-size: 1em;\n    font-weight: 700;\n    line-height: 1.5625em;\n    margin: 0;\n    min-width: 6.25em;\n    padding: 0.875em 1.875em;\n    position: relative;\n    text-align: center;\n    text-decoration: none;\n    user-select: none;\n    vertical-align: middle;\n    display: inline-block;\n    width: auto;\n}\n.aviva-fixed p {\nmargin: 0.625em 0;\n}\n</style>\n\n<div class=\"aviva-fixed\">\n<p>\nOur Live Chat service is currently closed.\n</p>\n<p>\nYou can discuss changes and queries with our chat team within our opening hours:\n</p>\n<p>\n<u>Live chat opening times:</u>\n</p>\n<p>\nMonday - Friday - 07:00 - 20:00<br/>\nSaturday - 08:00 - 17:00<br/>\nSunday - 08:00 - 16:00\n</p>\n<p>\nOpening times may vary on bank holidays.\n</p>\n<a class=\"aviva-button-disabl