ht {\n\tbackground-image:url(bg_mid_red.png);\n\tbackground-repeat:repeat-x;\n\tbackground-position:0 0;\n}\n.cob-user-ui-mid {\n\tbackground-image:url(bg_mid_red.png);\n\tbackground-repeat:repeat-x;\n\twidth:100%;\n\theight:35px;\n\tpadding-top:5px;\n}\n.cob-user-connected .cob-user-ui-left {\n\tbackground-image:url(bg_left_green.png);\n}\n.cob-user-connected .cob-user-ui-right {\n\tbackground-image:url(bg_right_green.png);\n}\n.cob-user-connected .cob-user-ui-mid {\n\tbackground-image:url(bg_mid_green.png);\n}\n.ie6 .cob-user-connected .cob-user-ui-left, .ie6 .cob-user-connected .cob-user-ui-right {\n\tbackground-image:url(bg_mid_green.png);\n}\n.cob-agent-message {\n    font-family: Arial,Verdana,sans-serif;\n    font-size: 16px;\n    line-height: 20px;\n    position: absolute;\n    text-align: center;\n    vertical-align: ce;\n    width: calc(100% - 431px);\n    align-items: center;\n    padding: 0px 20px;\n    display: flex;\n    height: 100%;\n}\n.cob-user-connected .cob-agent-message {\n    color: #CCCCCC;\n}\n.cob-user-ui a.cob-button {\n    display: inline-block;\n    color: #CCCCCC;\n    text-decoration: none;\n    font-family: Helvetica,Arial,\'Helvetica Neue\',sans-serif;\n    font-size: 11px;\n    font-weight: bold;\n    position: absolute;\n    top: 5px;\n}\n.cob-user-ui a.cob-button-disabled {\n\tdisplay:none;\n}\n.cob-icon {\n\tbackground-position:0;\n\tbackground-repeat:no-repeat;\n\tborder:none;\n\tdisplay:inline-block;\n\theight:16px;\n\twidth:16px;\n\tmargin:0 5px 0 0;\n\tpadding:0;\n\tposition:relative;\n\ttop:5px;\n\t*top:2px;/*IE*/\n}\n\n.cob-user-connected a.cob-button {\n    color: #CCCCCC;\n}\n.end-cob-button {\n        text-decoration: none;\n\t    color: #004FB6;\n\t    font-weight: bold;\n\t\tdisplay: inline-block;\n\t\tbackground: #ffffff;\n\t\tborder-radius: 4px;\n\t\theight: 55px;\n\t\tborder: 1px solid #cccccc;\n\t    text-decoration: none;\n\t    text-align: center;\n\t    margin-top: 15px;\n\t    padding: 14px 30px 0 30px;\n\t    position: absolute;\n\t    right: 230px;\n}\n.cob-button#stop {\n        text-decoration: none;\n\t    color: #004FB6;\n\t    font-weight: bold;\n\t\tdisplay: inline-block;\n\t\tbackground: #ffffff;\n\t\tborder-radius: 4px;\n\t\theight: 55px;\n\t\tborder: 1px solid #cccccc;\n\t    text-decoration: none;\n\t    text-align: center;\n\t    padding: 14px 30px 0 30px;\n\t    position: absolute;\n\t    right: 20px;\n      margin-top: 15px;\n}\n.cob-stop-icon {\n\tbackground-image:url(icon_disconnect.png);\n\t*background-image:url(icon_disconnect_1.png);\n}\n.cob-button#reconnect {\n\tleft:20px;\n}\n.cob-reconnect-icon {\n\tbackground-image:url(icon_reconnect.png);\n}\n.cob-button#terms-conditions {\n}\n.cob-terms-conditions-icon {\n\tbackground-image:url(icon_terms_red.png);\n\twidth:5px;\n\ttop:4px;\n\t*top:1px;/*IE*/\n\tmargin:0 4px 0 0;\n}\n.cob-user-connected .cob-terms-conditions-icon {\n\tbackground-image:url(icon_terms_green.png);\n}\n.cob-terms-and-conditions {\n\topacity:0.9;\n\tfilter:alpha(opacity=90);\n\tdisplay: none;\n\tborder: 2px double red;\n    margin: 0px;\n    padding: 0px;\n    position: fixed;\n\ttop: 32px;\n\tbottom:32px;\n\tleft:32px;\n\tright:32px;\n\tbackground-color: Linen;\n    z-index: 16;\n}\n.cob-tac-Close {\n\tdisplay: none;\n    margin: 0px;\n    padding: 0px;\n    cursor: pointer;\n    height: 31px;\n    width: 31px;\n    position: fixed;\n    right: 15px;\n    top: 15px;\n    z-index: 16;\n    background: url(\"XButton.png\") no-repeat scroll 0 0 transparent;\n}\n.cob-tac-text {\n\tposition:absolute;\n\tleft:17px;\n\tright:17px;\n\ttop:17px;\n\tbottom:17px;\n\toverflow:scroll;\n\toverflow-x:auto;\n\toverflow-y:scroll;\n}\n/**\n * See RTDEV-15908 for details\n * Changing the Cobrowse Banner UI for phones.\n */\n.termsAndCondDiv{\n\tposition:fixed;\n\ttop:0;\n\tz-index:99999;\n\tdisplay: block;\n\theight:500px;\n\tbackground:white;\n\tborder: 1px solid black;\n}\n\n.termsAndCondCloseDiv {\n\twidth:30px;\n\theight:30px;\n\tposition:relative;\n\tbackground:#960707;\n\tfloat:right;\n}\n\n.hamBugMenuDisplay {\n\tdisplay:block;\n}\n\n@media only screen and (min-width: 600px) {\n\ta.hamBugMenuIcon{\n\t\tdisplay:none !important;\n\t}\n\t.hamBugMenuDisplay{\n\t\tdisplay:none !important;\n\t}\n}\n\n.cob-button-display {\n\tdisplay:block;\n}\n\n@media screen and (min-width: 200px) and (max-width: 900px) {\n  .cob-banner {\n      font-family: source_sans_proregular,-apple-system,blinkmacsystemfont,Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,Fira Sans,Droid Sans,Helvetica Neue,arial,helvetica,sans-serif !important;\n      font-size: 14px;\n      height: 60px;\n      color: #CCCCCC;\n      background: #0B52B2;\n      border-radius: 4px;\n      position: absolute;\n      z-index: 999;\n      display: block;\n      height: 70px;\n      width: 80%;\n  }\n\t/* .cob-button-display{\n\t\tdisplay:none !important;\n\t} */\n  .cob-button#stop {\n      text-decoration: none;\n      color: #004FB6;\n      font-weight: bold;\n      display: inline-block;\n      background: #ffffff;\n      border-radius: 4px;\n      height: 46px;\n      /* border: 1px solid #cccccc; */\n      text-decoration: none;\n      text-align: center;\n      padding: 2px 2px 5px 0px;\n      position: absolute;\n      right: 10px;\n      width: 86px;\n      margin-top: 12px;\n  }\n    .end-cob-button {\n      /* text-decoration: none;\n      color: #004FB6; */\n      font-weight: bold;\n      display: inline-block;\n      background: #ffffff;\n      border-radius: 4px;\n      height: 46px;\n      border: 1px solid #cccccc;\n      text-decoration: none;\n      text-align: center;\n      /* margin-top: 15px; */\n      padding: 2px 2px 5px 0px;\n      position: absolute;\n      right: 110px;\n      width: 86px;\n      margin-top: 12px;\n  }\n  .cob-agent-message {\n    font-family: Arial,Verdana,sans-serif;\n    font-size: 14px;\n    line-height: 20px;\n    position: absolute;\n    text-align: center;\n    vertical-align: ce;\n    width: calc(100% - 200px);\n    align-items: center;\n    padding: 0px 5px;\n    display: flex;\n    height: 100%;\n  }\n}\n\n@media screen and (max-width: 530px) {\n  .cob-agent-message {\n    font-family: Arial,Verdana,sans-serif;\n    font-size: 12px;\n    line-height: 16px;\n  }\n}\n\n.hamBugMenuBox {\n\tz-index:1000000;\n\tfont-weight:bold;\n\tfont-size:0.8em;\n\twidth:50%;\n\tbackground:#f1f1f1;\n\tposition:fixed;\n\ttext-align:left;\n\tfont-size:12px;\n\tbottom:32px;\n\tmargin-left:5px;\n}\n\na.hamBugMenuIcon {\n\tbackground: url(\"mobMenu.png\") no-repeat scroll 0 4px #960707;\n\tfloat: left;\n\tfont-size: 0;\n\theight: 32px;\n\twidth: 27px;\n}\n.hamBugMenuBox ul {\n\tmargin-left: 0;\n\tpadding: 0;\n\tlist-style-type: none;\n\tlist-style-image: none;\n\twidth:100%\n}\n.hamBugMenuBox li {\n\tdisplay: block;\n\tpadding:15px 0 15px 15px;\n\tborder-bottom:#dddddd 1px solid;\n}\n</style>"}},{id:10006239,messages:{"cobrowseBanner_hash":"ce1024b7589cd56fbd61780b83904783","customerAcceptsSharedControl":"Customer accepts shared control","agentEndCobrowseSession":"Agent ends CoBrowse","cobrowseUnexpectedFail":"CoBrowse has been failed and closed unexpectedly","customerDeclinesCobrowse":"Customer declines CoBrowse invitation","cobrowseEnableMinimizeRestore":"false","customerEndCobrowseSession":"Customer ends CoBrowse","cobrowseSuppressed":"CoBrowse has been suppressed on this page. (cobrowse is stopped on the page)","enableCobrowseHighlight":"true","customerAcceptsCobrowse":"Customer accepts CoBrowse invitation","customerDeclinesSharedControl":"Customer declines shared control","cobrowseTestSuccess":"Cobrowse client performance test is finished successfully","cobrowseTestFail":"Cobrowse client performance test has been failed","cobrowseBanner":"<div class=\"cob-banner cob-banner-bottom\" id=\"tcCob\" style=\"\" aria-live=\"polite\">\n    <section class=\"mainContent\">\n    <div class=\"cob-agent-message\" id=\"agentNotConnected\" style=\"display:none;\" aria-hidden=\"true\">\n        You\'re no longer connected\n    </div>\n    <div class=\"cob-agent-message\" id=\"agentAssisted\" style=\"color: #ffffff;\" onclick=\"(inqFrame.Inq.CBC).toggleMenuBoxForCobBanner();\" tabindex=\"0\">\n       <div>\n        You are currently sharing your screen with the Aviva Help &amp Support Team. <a class=\"cob-button\" href=\"#\" id=\"terms-conditions\" onclick=\"window.open(\'https://media-eu2.inq.com/media/sites/10006020/flash//aviva-dsk_cobrowse/Co-Browse-TERMS&CONDITIONS.html\',\'terms_conditions\',\'toolbar=no,location=no,menubar=no,status=no,scrollbars=yes,resizable=1,height=660,width=615\');return false;\"></span>Terms &#38; Conditions</a>\n      </div>\n    </div>\n    <!--\n    <div class=\"cob-agent-message hamBugMenuDisplay\" onclick=\"(inqFrame.Inq.CBC).toggleMenuBoxForCobBanner();\">\n        <a class=\"hamBugMenuIcon highlight\" </a>\n    </div>\n    -->\n    <div>\n        <a class=\"end-cob-button\" href=\"#\" id=\"stop\" onclick=\"(inqFrame.Inq.CBC).stop(); return false;\">Stop screen sharing</a>\n    </div>\n    <div class=\"cob-ui-buttons cob-button-display\">\n        <a class=\"cob-button\" href=\"#\" id=\"stop\" onclick=\"(inqFrame.Inq.CBC).stop(); inqFrame.Inq.FlashPeer.ciActionBtnCloseChat(); return false;\">End chat session</a>\n    </div>\n</div>\n\n<!-- <div class=\"hamBugMenuBox\" id=\"hamBugMenuBoxId\" style=\"display:none;\">\n    <ul class=\"accordion\" style=\"margin:0;background:#2380D2;\">\n        <li class=\"\" style=\"background:#2380D2;\">\n            <a href=\"#\" id=\"stop\" style=\"color:#ffffff;\" onclick=\"(inqFrame.Inq.CBC).stop(); return false;\">Stop screen sharing</a>\n        </li>\n        <li class=\"\" style=\"background:#2380D2;\">\n            <a href=\"#\" style=\"color:#ffffff;\" onclick=\"(inqFrame.Inq.CBC).stop(); inqFrame.Inq.FlashPeer.ciActionRestoreAndExitChat(); return false;\" >End chat session</a>\n        </li>\n        <li class=\"\" style=\"background:#2380D2;\">\n            <a href=\"#\" id=\"terms-conditions\" style=\"color:#ffffff;\" >Terms &#38; Conditions</a>\n        </li>\n    </ul>\n  </div>-->\n\n\n<div class=\"termsAndCondDiv\" id=\"termsAndCondId\" style=\"display:none;\">\n    <div class=\"termsAndCondCloseDiv\">\n        <a href=\"\" onclick=\"(inqFrame.Inq.CBC).toggleTermsAndConditionDivForCobBanner();return false;\"><img aria-hidden=\"true\" src=\"https://media-eu2.inq.com/media/sites/10006020/flash//aviva-dsk_cobrowse/Co-Browse-TERMS&CONDITIONS.html\" style=\"width: 30px; height: 30px;\" tabindex=\"-1\"></a>\n    </div>\n    <iframe height=\"100%\" src=\"https://media-eu2.inq.com/media/sites/10006020/flash//aviva-dsk_cobrowse/Co-Browse-TERMS&CONDITIONS.html\" width=\"100%\"></iframe>\n</div>\n<div class=\"cob-tac-Close\" id=\"coTacClose\" onclick=\"(inqFrame.Inq.CBC).termsAndConditions(false); return false;\"></div>\n<style type=\"text/css\">\n\n    .cob-banner a {\n    }\ndiv#tcCobrowseBannerDiv * {\n      box-sizing: border-box;\n }\n    .cob-button#terms-conditions {\n        color: #ffffff;\n        font-weight: bold;\n    }\na.hamBugMenuIcon {\n    font-family: Arial,Helvetica,sans-serif;\n    background-color:#2380D2;\n}\n#tcChat_Minimized {\n    bottom:32px!important;\n}\n\n\n.cob-banner {\n    font-family: source_sans_proregular,-apple-system,blinkmacsystemfont,Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,Fira Sans,Droid Sans,Helvetica Neue,arial,helvetica,sans-serif !important;\n    font-size: 16px;\n    height: 60px;\n    color: #CCCCCC;\n    background: #0B52B2;\n    border-radius: 4px;\n    position: absolute;\n    z-index: 999;\n    display: block;\n    height: 85px;\n    width: 70%;\n}\n.cob-banner-top {\n    position: fixed;\n    left: 0px;\n    right: 0px;\n    top: 0px;\n}\n.cob-banner-bottom {\n\tposition: fixed;\n\tleft: 20px;\n\tright: 0px;\n\tbottom: 20px;\n}\n.cob-user-ui {\n\tfont-family:Arial,Verdana,sans-serif;\n\tfont-size:11px;\n\tposition:relative;\n\tcolor:  #CCCCCC;\n}\n.cob-ui-buttons {\n\tposition:absolute;\n\twidth:100%;\n}\n.cob-user-ui-left {\n\t/* safari prefetch */\n\tbackground-image:url(bg_left_green.png);\n\tbackground-image:url(bg_right_green.png);\n\tbackground-image:url(bg_mid_green.png);\n\t/* end safari prefetch */\n\tbackground-image:url(bg_left_red.png);\n\tbackground-repeat:no-repeat;\n\tpadding-left:320px;\n}\n.cob-user-ui-right {\n\tbackground-image:url(bg_right_red.png);\n\tbackground-repeat:no-repeat;\n\tpadding-right:320px;\n\tbackground-position:100% 0;\n}\n.ie6 .cob-user-ui-left, .ie6 .cob-user-ui-right {\n\tbackground-image:url(bg_mid_red.png);\n\tbackground-repeat:repeat-x;\n\tbackground-position:0 0;\n}\n.cob-user-ui-mid {\n\tbackground-image:url(bg_mid_red.png);\n\tbackground-repeat:repeat-x;\n\twidth:100%;\n\theight:35px;\n\tpadding-top:5px;\n}\n.cob-user-connected .cob-user-ui-left {\n\tbackground-image:url(bg_left_green.png);\n}\n.cob-user-connected .cob-user-ui-right {\n\tbackground-image:url(bg_right_green.png);\n}\n.cob-user-connected .cob-user-ui-mid {\n\tbackground-image:url(bg_mid_green.png);\n}\n.ie6 .cob-user-connected .cob-user-ui-left, .ie6 .cob-user-connected .cob-user-ui-right {\n\tbackground-image:url(bg_mid_green.png);\n}\n.cob-agent-message {\n    font-family: Arial,Verdana,sans-serif;\n    font-size: 16px;\n    line-height: 20px;\n    position: absolute;\n    text-align: center;\n    vertical-align: ce;\n    width: calc(100% - 431px);\n    align-items: center;\n    padding: 0px 20px;\n    display: flex;\n    height: 100%;\n}\n.cob-user-connected .cob-agent-message {\n    color: #CCCCCC;\n}\n.cob-user-ui a.cob-button {\n    display: inline-block;\n    color: #CCCCCC;\n    text-decoration: none;\n    font-family: Helvetica,Arial,\'Helvetica Neue\',sans-serif;\n    font-size: 11px;\n    font-weight: bold;\n    position: absolute;\n    top: 5px;\n}\n.cob-user-ui a.cob-button-disabled {\n\tdisplay:none;\n}\n.cob-icon {\n\tbackground-position:0;\n\tbackground-repeat:no-repeat;\n\tborder:none;\n\tdisplay:inline-block;\n\theight:16px;\n\twidth:16px;\n\tmargin:0 5px 0 0;\n\tpadding:0;\n\tposition:relative;\n\ttop:5px;\n\t*top:2px;/*IE*/\n}\n\n.cob-user-connected a.cob-button {\n    color: #CCCCCC;\n}\n.end-cob-button {\n        text-decoration: none;\n\t    color: #004FB6;\n\t    font-weight: bold;\n\t\tdisplay: inline-block;\n\t\tbackground: #ffffff;\n\t\tborder-radius: 4px;\n\t\theight: 55px;\n\t\tborder: 1px solid #cccccc;\n\t    text-decoration: none;\n\t    text-align: center;\n\t    margin-top: 15px;\n\t    padding: 14px 30px 0 30px;\n\t    position: absolute;\n\t    right: 230px;\n}\n.cob-button#stop {\n        text-decoration: none;\n\t    color: #004FB6;\n\t    font-weight: bold;\n\t\tdisplay: inline-block;\n\t\tbackground: #ffffff;\n\t\tborder-radius: 4px;\n\t\theight: 55px;\n\t\tborder: 1px solid #cccccc;\n\t    text-decoration: none;\n\t    text-align: center;\n\t    padding: 14px 30px 0 30px;\n\t    position: absolute;\n\t    right: 20px;\n      margin-top: 15px;\n}\n.cob-stop-icon {\n\tbackground-image:url(icon_disconnect.png);\n\t*background-image:url(icon_disconnect_1.png);\n}\n.cob-button#reconnect {\n\tleft:20px;\n}\n.cob-reconnect-icon {\n\tbackground-image:url(icon_reconnect.png);\n}\n.cob-button#terms-conditions {\n}\n.cob-terms-conditions-icon {\n\tbackground-image:url(icon_terms_red.png);\n\twidth:5px;\n\ttop:4px;\n\t*top:1px;/*IE*/\n\tmargin:0 4px 0 0;\n}\n.cob-user-connected .cob-terms-conditions-icon {\n\tbackground-image:url(icon_terms_green.png);\n}\n.cob-terms-and-conditions {\n\topacity:0.9;\n\tfilter:alpha(opacity=90);\n\tdisplay: none;\n\tborder: 2px double red;\n    margin: 0px;\n    padding: 0px;\n    position: fixed;\n\ttop: 32px;\n\tbottom:32px;\n\tleft:32px;\n\tright:32px;\n\tbackground-color: Linen;\n    z-index: 16;\n}\n.cob-tac-Close {\n\tdisplay: none;\n    margin: 0px;\n    padding: 0px;\n    cursor: pointer;\n    height: 31px;\n    width: 31px;\n    position: fixed;\n    right: 15px;\n    top: 15px;\n    z-index: 16;\n    background: url(\"XButton.png\") no-repeat scroll 0 0 transparent;\n}\n.cob-tac-text {\n\tposition:absolute;\n\tleft:17px;\n\tright:17px;\n\ttop:17px;\n\tbottom:17px;\n\toverflow:scroll;\n\toverflow-x:auto;\n\toverflow-y:scroll;\n}\n/**\n * See RTDEV-15908 for details\n * Changing the Cobrowse Banner UI for phones.\n */\n.termsAndCondDiv{\n\tposition:fixed;\n\ttop:0;\n\tz-index:99999;\n\tdisplay: block;\n\theight:500px;\n\tbackground:white;\n\tborder: 1px solid black;\n}\n\n.termsAndCondCloseDiv {\n\twidth:30px;\n\theight:30px;\n\tposition:relative;\n\tbackground:#960707;\n\tfloat:right;\n}\n\n.hamBugMenuDisplay {\n\tdisplay:block;\n}\n\n@media only screen and (min-width: 600px) {\n\ta.hamBugMenuIcon{\n\t\tdisplay:none !important;\n\t}\n\t.hamBugMenuDisplay{\n\t\tdisplay:none !important;\n\t}\n}\n\n.cob-button-display {\n\tdisplay:block;\n}\n\n@media screen and (min-width: 200px) and (max-width: 900px) {\n  .cob-banner {\n      font-family: source_sans_proregular,-apple-system,blinkmacsystemfont,Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,Fira Sans,Droid Sans,Helvetica Neue,arial,helvetica,sans-serif !important;\n      font-size: 14px;\n      height: 60px;\n      color: #CCCCCC;\n      background: #0B52B2;\n      border-radius: 4px;\n      position: absolute;\n      z-index: 999;\n      display: block;\n      height: 70px;\n      width: 80%;\n  }\n\t/* .cob-button-display{\n\t\tdisplay:none !important;\n\t} */\n  .cob-button#stop {\n      text-decoration: none;\n      color: #004FB6;\n      font-weight: bold;\n      display: inline-block;\n      background: #ffffff;\n      border-radius: 4px;\n      height: 46px;\n      /* border: 1px solid #cccccc; */\n      text-decoration: none;\n      text-align: center;\n      padding: 2px 2px 5px 0px;\n      position: absolute;\n      right: 10px;\n      width: 86px;\n      margin-top: 12px;\n  }\n    .end-cob-button {\n      /* text-decoration: none;\n      color: #004FB6; */\n      font-weight: bold;\n      display: inline-block;\n      background: #ffffff;\n      border-radius: 4px;\n      height: 46px;\n      border: 1px solid #cccccc;\n      text-decoration: none;\n      text-align: center;\n      /* margin-top: 15px; */\n      padding: 2px 2px 5px 0px;\n      position: absolute;\n      right: 110px;\n      width: 86px;\n      margin-top: 12px;\n  }\n  .cob-agent-message {\n    font-family: Arial,Verdana,sans-serif;\n    font-size: 14px;\n    line-height: 20px;\n    position: absolute;\n    text-align: center;\n    vertical-align: ce;\n    width: calc(100% - 200px);\n    align-items: center;\n    padding: 0px 5px;\n    display: flex;\n    height: 100%;\n  }\n}\n\n@media screen and (max-width: 530px) {\n  .cob-agent-message {\n    font-family: Arial,Verdana,sans-serif;\n    font-size: 12px;\n    line-height: 16px;\n  }\n}\n\n.hamBugMenuBox {\n\tz-index:1000000;\n\tfont-weight:bold;\n\tfont-size:0.8em;\n\twidth:50%;\n\tbackground:#f1f1f1;\n\tposition:fixed;\n\ttext-align:left;\n\tfont-size:12px;\n\tbottom:32px;\n\tmargin-left:5px;\n}\n\na.hamBugMenuIcon {\n\tbackground: url(\"mobMenu.png\") no-repeat scroll 0 4px #960707;\n\tfloat: left;\n\tfont-size: 0;\n\theight: 32px;\n\twidth: 27px;\n}\n.hamBugMenuBox ul {\n\tmargin-left: 0;\n\tpadding: 0;\n\tlist-style-type: none;\n\tlist-style-image: none;\n\twidth:100%\n}\n.hamBugMenuBox li {\n\tdisplay: block;\n\tpadding:15px 0 15px 15px;\n\tborder-bottom:#dddddd 1px solid;\n}\n</style>"}},{id:10006088,messages:{"cobrowseBanner_hash":"ce1024b7589cd56fbd61780b83904783","customerAcceptsSharedControl":"Customer accepts shared control","agentEndCobrowseSession":"Agent ends CoBrowse","cobrowseUnexpectedFail":"CoBrowse has been failed and closed unexpectedly","customerDeclinesCobrowse":"Customer declines CoBrowse invitation","cobrowseEnableMinimizeRestore":"false","customerEndCobrowseSession":"Customer ends CoBrowse","cobrowseSuppressed":"CoBrowse has been suppressed on this page. (cobrowse is stopped on the page)","enableCobrowseHighlight":"true","customerAcceptsCobrowse":"Customer accepts CoBrowse invitation","customerDeclinesSharedControl":"Customer declines shared control","cobrowseTestSuccess":"Cobrowse client performance test is finished successfully","cobrowseTestFail":"Cobrowse client performance test has been failed","cobrowseBanner":"<div class=\"cob-banner cob-banner-bottom\" id=\"tcCob\" style=\"\" aria-live=\"polite\">\n    <section class=\"mainContent\">\n    <div class=\"cob-agent-message\" id=\"agentNotConnected\" style=\"display:none;\" aria-hidden=\"true\">\n        You\'re no longer connected\n    </div>\n    <div class=\"cob-agent-message\" id=\"agentAssisted\" style=\"color: #ffffff;\" onclick=\"(inqFrame.Inq.CBC).toggleMenuBoxForCobBanner();\" tabindex=\"0\">\n       <div>\n        You are currently sharing your screen with the Aviva Help &amp Support Team. <a class=\"cob-button\" href=\"#\" id=\"terms-conditions\" onclick=\"window.open(\'https://media-eu2.inq.com/media/sites/10006020/flash//aviva-dsk_cobrowse/Co-Browse-TERMS&CONDITIONS.html\',\'terms_conditions\',\'toolbar=no,location=no,menubar=no,status=no,scrollbars=yes,resizable=1,height=660,width=615\');return false;\"></span>Terms &#38; Conditions</a>\n      </div>\n    </div>\n    <!--\n    <div class=\"cob-agent-message hamBugMenuDisplay\" onclick=\"(inqFrame.Inq.CBC).toggleMenuBoxForCobBanner();\">\n        <a class=\"hamBugMenuIcon highlight\" </a>\n    </div>\n    -->\n    <div>\n        <a class=\"end-cob-button\" href=\"#\" id=\"stop\" onclick=\"(inqFrame.Inq.CBC).stop(); return false;\">Stop screen sharing</a>\n    </div>\n    <div class=\"cob-ui-buttons cob-button-display\">\n        <a class=\"cob-button\" href=\"#\" id=\"stop\" onclick=\"(inqFrame.Inq.CBC).stop(); inqFrame.Inq.FlashPeer.ciActionBtnCloseChat(); return false;\">End chat session</a>\n    </div>\n</div>\n\n<!-- <div class=\"hamBugMenuBox\" id=\"hamBugMenuBoxId\" style=\"display:none;\">\n    <ul class=\"accordion\" style=\"margin:0;background:#2380D2;\">\n        <li class=\"\" style=\"background:#2380D2;\">\n            <a href=\"#\" id=\"stop\" style=\"color:#ffffff;\" onclick=\"(inqFrame.Inq.CBC).stop(); return false;\">Stop screen sharing</a>\n        </li>\n        <li class=\"\" style=\"background:#2380D2;\">\n            <a href=\"#\" style=\"color:#ffffff;\" onclick=\"(inqFrame.Inq.CBC).stop(); inqFrame.Inq.FlashPeer.ciActionRestoreAndExitChat(); return false;\" >End chat session</a>\n        </li>\n        <li class=\"\" style=\"background:#2380D2;\">\n            <a href=\"#\" id=\"terms-conditions\" style=\"color:#ffffff;\" >Terms &#38; Conditions</a>\n        </li>\n    </ul>\n  </div>-->\n\n\n<div class=\"termsAndCondDiv\" id=\"termsAndCondId\" style=\"display:none;\">\n    <div class=\"termsAndCondCloseDiv\">\n        <a href=\"\" onclick=\"(inqFrame.Inq.CBC).toggleTermsAndConditionDivForCobBanner();return false;\"><img aria-hidden=\"true\" src=\"https://media-eu2.inq.com/media/sites/10006020/flash//aviva-dsk_cobrowse/Co-Browse-TERMS&CONDITIONS.html\" style=\"width: 30px; height: 30px;\" tabindex=\"-1\"></a>\n    </div>\n    <iframe height=\"100%\" src=\"https://media-eu2.inq.com/media/sites/10006020/flash//aviva-dsk_cobrowse/Co-Browse-TERMS&CONDITIONS.html\" width=\"100%\"></iframe>\n</div>\n<div class=\"cob-tac-Close\" id=\"coTacClose\" onclick=\"(inqFrame.Inq.CBC).termsAndConditions(false); return false;\"></div>\n<style type=\"text/css\">\n\n    .cob-banner a {\n    }\ndiv#tcCobrowseBannerDiv * {\n      box-sizing: border-box;\n }\n    .cob-button#terms-conditions {\n        color: #ffffff;\n        font-weight: bold;\n    }\na.hamBugMenuIcon {\n    font-family: Arial,Helvetica,sans-serif;\n    background-color:#2380D2;\n}\n#tcChat_Minimized {\n    bottom:32px!important;\n}\n\n\n.cob-banner {\n    font-family: source_sans_proregular,-apple-system,blinkmacsystemfont,Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,Fira Sans,Droid Sans,Helvetica Neue,arial,helvetica,sans-serif !important;\n    font-size: 16px;\n    height: 60px;\n    color: #CCCCCC;\n    background: #0B52B2;\n    border-radius: 4px;\n    position: absolute;\n    z-index: 999;\n    display: block;\n    height: 85px;\n    width: 70%;\n}\n.cob-banner-top {\n    position: fixed;\n    left: 0px;\n    right: 0px;\n    top: 0px;\n}\n.cob-banner-bottom {\n\tposition: fixed;\n\tleft: 20px;\n\tright: 0px;\n\tbottom: 20px;\n}\n.cob-user-ui {\n\tfont-family:Arial,Verdana,sans-serif;\n\tfont-size:11px;\n\tposition:relative;\n\tcolor:  #CCCCCC;\n}\n.cob-ui-buttons {\n\tposition:absolute;\n\twidth:100%;\n}\n.cob-user-ui-left {\n\t/* safari prefetch */\n\tbackground-image:url(bg_left_green.png);\n\tbackground-image:url(bg_right_green.png);\n\tbackground-image:url(bg_mid_green.png);\n\t/* end safari prefetch */\n\tbackground-image:url(bg_left_red.png);\n\tbackground-repeat:no-repeat;\n\tpadding-left:320px;\n}\n.cob-user-ui-right {\n\tbackground-image:url(bg_right_red.png);\n\tbackground-repeat:no-repeat;\n\tpadding-right:320px;\n\tbackground-position:100% 0;\n}\n.ie6 .cob-user-ui-left, .ie6 .cob-user-ui-right {\n\tbackground-image:url(bg_mid_red.png);\n\tbackground-repeat:repeat-x;\n\tbackground-position:0 0;\n}\n.cob-user-ui-mid {\n\tbackground-image:url(bg_mid_red.png);\n\tbackground-repeat:repeat-x;\n\twidth:100%;\n\theight:35px;\n\tpadding-top:5px;\n}\n.cob-user-connected .cob-user-ui-left {\n\tbackground-image:url(bg_left_green.png);\n}\n.cob-user-connected .cob-user-ui-right {\n\tbackground-image:url(bg_right_green.png);\n}\n.cob-user-connected .cob-user-ui-mid {\n\tbackground-image:url(bg_mid_green.png);\n}\n.ie6 .cob-user-connected .cob-user-ui-left, .ie6 .cob-user-connected .cob-user-ui-right {\n\tbackground-image:url(bg_mid_green.png);\n}\n.cob-agent-message {\n    font-family: Arial,Verdana,sans-serif;\n    font-size: 16px;\n    line-height: 20px;\n    position: absolute;\n    text-align: center;\n    vertical-align: ce;\n    width: calc(100% - 431px);\n    align-items: center;\n    padding: 0px 20px;\n    display: flex;\n    height: 100%;\n}\n.cob-user-connected .cob-agent-message {\n    color: #CCCCCC;\n}\n.cob-user-ui a.cob-button {\n    display: inline-block;\n    color: #CCCCCC;\n    text-decoration: none;\n    font-family: Helvetica,Arial,\'Helvetica Neue\',sans-serif;\n    font-size: 11px;\n    font-weight: bold;\n    position: absolute;\n    top: 5px;\n}\n.cob-user-ui a.cob-button-disabled {\n\tdisplay:none;\n}\n.cob-icon {\n\tbackground-position:0;\n\tbackground-repeat:no-repeat;\n\tborder:none;\n\tdisplay:inline-block;\n\theight:16px;\n\twidth:16px;\n\tmargin:0 5px 0 0;\n\tpadding:0;\n\tposition:relative;\n\ttop:5px;\n\t*top:2px;/*IE*/\n}\n\n.cob-user-connected a.cob-button {\n    color: #CCCCCC;\n}\n.end-cob-button {\n        text-decoration: none;\n\t    color: #004FB6;\n\t    font-weight: bold;\n\t\tdisplay: inline-block;\n\t\tbackground: #ffffff;\n\t\tborder-radius: 4px;\n\t\theight: 55px;\n\t\tborder: 1px solid #cccccc;\n\t    text-decoration: none;\n\t    text-align: center;\n\t    margin-top: 15px;\n\t    padding: 14px 30px 0 30px;\n\t    position: absolute;\n\t    right: 230px;\n}\n.cob-button#stop {\n        text-decoration: none;\n\t    color: #004FB6;\n\t    font-weight: bold;\n\t\tdisplay: inline-block;\n\t\tbackground: #ffffff;\n\t\tborder-radius: 4px;\n\t\theight: 55px;\n\t\tborder: 1px solid #cccccc;\n\t    text-decoration: none;\n\t    text-align: center;\n\t    padding: 14px 30px 0 30px;\n\t    position: absolute;\n\t    right: 20px;\n      margin-top: 15px;\n}\n.cob-stop-icon {\n\tbackground-image:url(icon_disconnect.png);\n\t*background-image:url(icon_disconnect_1.png);\n}\n.cob-button#reconnect {\n\tleft:20px;\n}\n.cob-reconnect-icon {\n\tbackground-image:url(icon_reconnect.png);\n}\n.cob-button#terms-conditions {\n}\n.cob-terms-conditions-icon {\n\tbackground-image:url(icon_terms_red.png);\n\twidth:5px;\n\ttop:4px;\n\t*top:1px;/*IE*/\n\tmargin:0 4px 0 0;\n}\n.cob-user-connected .cob-terms-conditions-icon {\n\tbackground-image:url(icon_terms_green.png);\n}\n.cob-terms-and-conditions {\n\topacity:0.9;\n\tfilter:alpha(opacity=90);\n\tdisplay: none;\n\tborder: 2px double red;\n    margin: 0px;\n    padding: 0px;\n    position: fixed;\n\ttop: 32px;\n\tbottom:32px;\n\tleft:32px;\n\tright:32px;\n\tbackground-color: Linen;\n    z-index: 16;\n}\n.cob-tac-Close {\n\tdisplay: none;\n    margin: 0px;\n    padding: 0px;\n    cursor: pointer;\n    height: 31px;\n    width: 31px;\n    position: fixed;\n    right: 15px;\n    top: 15px;\n    z-index: 16;\n    background: url(\"XButton.png\") no-repeat scroll 0 0 transparent;\n}\n.cob-tac-text {\n\tposition:absolute;\n\tleft:17px;\n\tright:17px;\n\ttop:17px;\n\tbottom:17px;\n\toverflow:scroll;\n\toverflow-x:auto;\n\toverflow-y:scroll;\n}\n/**\n * See RTDEV-15908 for details\n * Changing the Cobrowse Banner UI for phones.\n */\n.termsAndCondDiv{\n\tposition:fixed;\n\ttop:0;\n\tz-index:99999;\n\tdisplay: block;\n\theight:500px;\n\tbackground:white;\n\tborder: 1px solid black;\n}\n\n.termsAndCondCloseDiv {\n\twidth:30px;\n\theight:30px;\n\tposition:relative;\n\tbackground:#960707;\n\tfloat:right;\n}\n\n.hamBugMenuDisplay {\n\tdisplay:block;\n}\n\n@media only screen and (min-width: 600px) {\n\ta.hamBugMenuIcon{\n\t\tdisplay:none !important;\n\t}\n\t.hamBugMenuDisplay{\n\t\tdisplay:none !important;\n\t}\n}\n\n.cob-button-display {\n\tdisplay:block;\n}\n\n@media screen and (min-width: 200px) and (max-width: 900px) {\n  .cob-banner {\n      font-family: source_sans_proregular,-apple-system,blinkmacsystemfont,Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,Fira Sans,Droid Sans,Helvetica Neue,arial,helvetica,sans-serif !important;\n      font-size: 14px;\n      height: 60px;\n      color: #CCCCCC;\n      background: #0B52B2;\n      border-radius: 4px;\n      position: absolute;\n      z-index: 999;\n      display: block;\n      height: 70px;\n      width: 80%;\n  }\n\t/* .cob-button-display{\n\t\tdisplay:none !important;\n\t} */\n  .cob-button#stop {\n      text-decoration: none;\n      color: #004FB6;\n      font-weight: bold;\n      display: inline-block;\n      background: #ffffff;\n      border-radius: 4px;\n      height: 46px;\n      /* border: 1px solid #cccccc; */\n      text-decoration: none;\n      text-align: center;\n      padding: 2px 2px 5px 0px;\n      position: absolute;\n      right: 10px;\n      width: 86px;\n      margin-top: 12px;\n  }\n    .end-cob-button {\n      /* text-decoration: none;\n      color: #004FB6; */\n      font-weight: bold;\n      display: inline-block;\n      background: #ffffff;\n      border-radius: 4px;\n      height: 46px;\n      border: 1px solid #cccccc;\n      text-decoration: none;\n      text-align: center;\n      /* margin-top: 15px; */\n      padding: 2px 2px 5px 0px;\n      position: absolute;\n      right: 110px;\n      width: 86px;\n      margin-top: 12px;\n  }\n  .cob-agent-message {\n    font-family: Arial,Verdana,sans-serif;\n    font-size: 14px;\n    line-height: 20px;\n    position: absolute;\n    text-align: center;\n    vertical-align: ce;\n    width: calc(100% - 200px);\n    align-items: center;\n    padding: 0px 5px;\n    display: flex;\n    height: 100%;\n  }\n}\n\n@media screen and (max-width: 530px) {\n  .cob-agent-message {\n    font-family: Arial,Verdana,sans-serif;\n    font-size: 12px;\n    line-height: 16px;\n  }\n}\n\n.hamBugMenuBox {\n\tz-index:1000000;\n\tfont-weight:bold;\n\tfont-size:0.8em;\n\twidth:50%;\n\tbackground:#f1f1f1;\n\tposition:fixed;\n\ttext-align:left;\n\tfont-size:12px;\n\tbottom:32px;\n\tmargin-left:5px;\n}\n\na.hamBugMenuIcon {\n\tbackground: url(\"mobMenu.png\") no-repeat scroll 0 4px #960707;\n\tfloat: left;\n\tfont-size: 0;\n\theight: 32px;\n\twidth: 27px;\n}\n.hamBugMenuBox ul {\n\tmargin-left: 0;\n\tpadding: 0;\n\tlist-style-type: none;\n\tlist-style-image: none;\n\twidth:100%\n}\n.hamBugMenuBox li {\n\tdisplay: block;\n\tpadding:15px 0 15px 15px;\n\tborder-bottom:#dddddd 1px solid;\n}\n</style>"}},{id:10006241,messages:{"cobrowseBanner_hash":"ce1024b7589cd56fbd61780b83904783","customerAcceptsSharedControl":"Customer accepts shared control","agentEndCobrowseSession":"Agent ends CoBrowse","cobrowseUnexpectedFail":"CoBrowse has been failed and closed unexpectedly","customerDeclinesCobrowse":"Customer declines CoBrowse invitation","cobrowseEnableMinimizeRestore":"false","customerEndCobrowseSession":"Customer ends CoBrowse","cobrowseSuppressed":"CoBrowse has been suppressed on this page. (cobrowse is stopped on the page)","enableCobrowseHighlight":"true","customerAcceptsCobrowse":"Customer accepts CoBrowse invitation","customerDeclinesSharedControl":"Customer declines shared control","cobrowseTestSuccess":"Cobrowse client performance test is finished successfully","cobrowseTestFail":"Cobrowse client performance test has been failed","cobrowseBanner":"<div class=\"cob-banner cob-banner-bottom\" id=\"tcCob\" style=\"\" aria-live=\"polite\">\n    <section class=\"mainContent\">\n    <div class=\"cob-agent-message\" id=\"agentNotConnected\" style=\"display:none;\" aria-hidden=\"true\">\n        You\'re no longer connected\n    </div>\n    <div class=\"cob-agent-message\" id=\"agentAssisted\" style=\"color: #ffffff;\" onclick=\"(inqFrame.Inq.CBC).toggleMenuBoxForCobBanner();\" tabindex=\"0\">\n       <div>\n        You are currently sharing your screen with the Aviva Help &amp Support Team. <a class=\"cob-button\" href=\"#\" id=\"terms-conditions\" onclick=\"window.open(\'https://media-eu2.inq.com/media/sites/10006020/flash//aviva-dsk_cobrowse/Co-Browse-TERMS&CONDITIONS.html\',\'terms_conditions\',\'toolbar=no,location=no,menubar=no,status=no,scrollbars=yes,resizable=1,height=660,width=615\');return false;\"></span>Terms &#38; Conditions</a>\n      </div>\n    </div>\n    <!--\n    <div class=\"cob-agent-message hamBugMenuDisplay\" onclick=\"(inqFrame.Inq.CBC).toggleMenuBoxForCobBanner();\">\n        <a class=\"hamBugMenuIcon highlight\" </a>\n    </div>\n    -->\n    <div>\n        <a class=\"end-cob-button\" href=\"#\" id=\"stop\" onclick=\"(inqFrame.Inq.CBC).stop(); return false;\">Stop screen sharing</a>\n    </div>\n    <div class=\"cob-ui-buttons cob-button-display\">\n        <a class=\"cob-button\" href=\"#\" id=\"stop\" onclick=\"(inqFrame.Inq.CBC).stop(); inqFrame.Inq.FlashPeer.ciActionBtnCloseChat(); return false;\">End chat session</a>\n    </div>\n</div>\n\n<!-- <div class=\"hamBugMenuBox\" id=\"hamBugMenuBoxId\" style=\"display:none;\">\n    <ul class=\"accordion\" style=\"margin:0;background:#2380D2;\">\n        <li class=\"\" style=\"background:#2380D2;\">\n            <a href=\"#\" id=\"stop\" style=\"color:#ffffff;\" onclick=\"(inqFrame.Inq.CBC).stop(); return false;\">Stop screen sharing</a>\n        </li>\n        <li class=\"\" style=\"background:#2380D2;\">\n            <a href=\"#\" style=\"color:#ffffff;\" onclick=\"(inqFrame.Inq.CBC).stop(); inqFrame.Inq.FlashPeer.ciActionRestoreAndExitChat(); return false;\" >End chat session</a>\n        </li>\n        <li class=\"\" style=\"background:#2380D2;\">\n            <a href=\"#\" id=\"terms-conditions\" style=\"color:#ffffff;\" >Terms &#38; Conditions</a>\n        </li>\n    </ul>\n  </div>-->\n\n\n<div class=\"termsAndCondDiv\" id=\"termsAndCondId\" style=\"display:none;\">\n    <div class=\"termsAndCondCloseDiv\">\n        <a href=\"\" onclick=\"(inqFrame.Inq.CBC).toggleTermsAndConditionDivForCobBanner();return false;\"><img aria-hidden=\"true\" src=\"https://media-eu2.inq.com/media/sites/10006020/flash//aviva-dsk_cobrowse/Co-Browse-TERMS&CONDITIONS.html\" style=\"width: 30px; height: 30px;\" tabindex=\"-1\"></a>\n    </div>\n    <iframe height=\"100%\" src=\"https://media-eu2.inq.com/media/sites/10006020/flash//aviva-dsk_cobrowse/Co-Browse-TERMS&CONDITIONS.html\" width=\"100%\"></iframe>\n</div>\n<div class=\"cob-tac-Close\" id=\"coTacClose\" onclick=\"(inqFrame.Inq.CBC).termsAndConditions(false); return false;\"></div>\n<style type=\"text/css\">\n\n    .cob-banner a {\n    }\ndiv#tcCobrowseBannerDiv * {\n      box-sizing: border-box;\n }\n    .cob-button#terms-conditions {\n        color: #ffffff;\n        font-weight: bold;\n    }\na.hamBugMenuIcon {\n    font-family: Arial,Helvetica,sans-serif;\n    background-color:#2380D2;\n}\n#tcChat_Minimized {\n    bottom:32px!important;\n}\n\n\n.cob-banner {\n    font-family: source_sans_proregular,-apple-system,blinkmacsystemfont,Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,Fira Sans,Droid Sans,Helvetica Neue,arial,helvetica,sans-serif !important;\n    font-size: 16px;\n    height: 60px;\n    color: #CCCCCC;\n    background: #0B52B2;\n    border-radius: 4px;\n    position: absolute;\n    z-index: 999;\n    display: block;\n    height: 85px;\n    width: 70%;\n}\n.cob-banner-top {\n    position: fixed;\n    left: 0px;\n    right: 0px;\n    top: 0px;\n}\n.cob-banner-bottom {\n\tposition: fixed;\n\tleft: 20px;\n\tright: 0px;\n\tbottom: 20px;\n}\n.cob-user-ui {\n\tfont-family:Arial,Verdana,sans-serif;\n\tfont-size:11px;\n\tposition:relative;\n\tcolor:  #CCCCCC;\n}\n.cob-ui-buttons {\n\tposition:absolute;\n\twidth:100%;\n}\n.cob-user-ui-left {\n\t/* safari prefetch */\n\tbackground-image:url(bg_left_green.png);\n\tbackground-image:url(bg_right_green.png);\n\tbackground-image:url(bg_mid_green.png);\n\t/* end safari prefetch */\n\tbackground-image:url(bg_left_red.png);\n\tbackground-repeat:no-repeat;\n\tpadding-left:320px;\n}\n.cob-user-ui-right {\n\tbackground-image:url(bg_right_red.png);\n\tbackground-repeat:no-repeat;\n\tpadding-right:320px;\n\tbackground-position:100% 0;\n}\n.ie6 .cob-user-ui-left, .ie6 .cob-user-ui-right {\n\tbackground-image:url(bg_mid_red.png);\n\tbackground-repeat:repeat-x;\n\tbackground-position:0 0;\n}\n.cob-user-ui-mid {\n\tbackground-image:url(bg_mid_red.png);\n\tbackground-repeat:repeat-x;\n\twidth:100%;\n\theight:35px;\n\tpadding-top:5px;\n}\n.cob-user-connected .cob-user-ui-left {\n\tbackground-image:url(bg_left_green.png);\n}\n.cob-user-connected .cob-user-ui-right {\n\tbackground-image:url(bg_right_green.png);\n}\n.cob-user-connected .cob-user-ui-mid {\n\tbackground-image:url(bg_mid_green.png);\n}\n.ie6 .cob-user-connected .cob-user-ui-left, .ie6 .cob-user-connected .cob-user-ui-right {\n\tbackground-image:url(bg_mid_green.png);\n}\n.cob-agent-message {\n    font-family: Arial,Verdana,sans-serif;\n    font-size: 16px;\n    line-height: 20px;\n    position: absolute;\n    text-align: center;\n    vertical-align: ce;\n    width: calc(100% - 431px);\n    align-items: center;\n    padding: 0px 20px;\n    display: flex;\n    height: 100%;\n}\n.cob-user-connected .cob-agent-message {\n    color: #CCCCCC;\n}\n.cob-user-ui a.cob-button {\n    display: inline-block;\n    color: #CCCCCC;\n    text-decoration: none;\n    font-family: Helvetica,Arial,\'Helvetica Neue\',sans-serif;\n    font-size: 11px;\n    font-weight: bold;\n    position: absolute;\n    top: 5px;\n}\n.cob-user-ui a.cob-button-disabled {\n\tdisplay:none;\n}\n.cob-icon {\n\tbackground-position:0;\n\tbackground-repeat:no-repeat;\n\tborder:none;\n\tdisplay:inline-block;\n\theight:16px;\n\twidth:16px;\n\tmargin:0 5px 0 0;\n\tpadding:0;\n\tposition:relative;\n\ttop:5px;\n\t*top:2px;/*IE*/\n}\n\n.cob-user-connected a.cob-button {\n    color: #CCCCCC;\n}\n.end-cob-button {\n        text-decoration: none;\n\t    color: #004FB6;\n\t    font-weight: bold;\n\t\tdisplay: inline-block;\n\t\tbackground: #ffffff;\n\t\tborder-radius: 4px;\n\t\theight: 55px;\n\t\tborder: 1px solid #cccccc;\n\t    text-decoration: none;\n\t    text-align: center;\n\t    margin-top: 15px;\n\t    padding: 14px 30px 0 30px;\n\t    position: absolute;\n\t    right: 230px;\n}\n.cob-button#stop {\n        text-decoration: none;\n\t    color: #004FB6;\n\t    font-weight: bold;\n\t\tdisplay: inline-block;\n\t\tbackground: #ffffff;\n\t\tborder-radius: 4px;\n\t\theight: 55px;\n\t\tborder: 1px solid #cccccc;\n\t    text-decoration: none;\n\t    text-align: center;\n\t    padding: 14px 30px 0 30px;\n\t    position: absolute;\n\t    right: 20px;\n      margin-top: 15px;\n}\n.cob-stop-icon {\n\tbackground-image:url(icon_disconnect.png);\n\t*background-image:url(icon_disconnect_1.png);\n}\n.cob-button#reconnect {\n\tleft:20px;\n}\n.cob-reconnect-icon {\n\tbackground-image:url(icon_reconnect.png);\n}\n.cob-button#terms-conditions {\n}\n.cob-terms-conditions-icon {\n\tbackground-image:url(icon_terms_red.png);\n\twidth:5px;\n\ttop:4px;\n\t*top:1px;/*IE*/\n\tmargin:0 4px 0 0;\n}\n.cob-user-connected .cob-terms-conditions-icon {\n\tbackground-image:url(icon_terms_green.png);\n}\n.cob-terms-and-conditions {\n\topacity:0.9;\n\tfilter:alpha(opacity=90);\n\tdisplay: none;\n\tborder: 2px double red;\n    margin: 0px;\n    padding: 0px;\n    position: fixed;\n\ttop: 32px;\n\tbottom:32px;\n\tleft:32px;\n\tright:32px;\n\tbackground-color: Linen;\n    z-index: 16;\n}\n.cob-tac-Close {\n\tdisplay: none;\n    margin: 0px;\n    padding: 0px;\n    cursor: pointer;\n    height: 31px;\n    width: 31px;\n    position: fixed;\n    right: 15px;\n    top: 15px;\n    z-index: 16;\n    background: url(\"XButton.png\") no-repeat scroll 0 0 transparent;\n}\n.cob-tac-text {\n\tposition:absolute;\n\tleft:17px;\n\tright:17px;\n\ttop:17px;\n\tbottom:17px;\n\toverflow:scroll;\n\toverflow-x:auto;\n\toverflow-y:scroll;\n}\n/**\n * See RTDEV-15908 for details\n * Changing the Cobrowse Banner UI for phones.\n */\n.termsAndCondDiv{\n\tposition:fixed;\n\ttop:0;\n\tz-index:99999;\n\tdisplay: block;\n\theight:500px;\n\tbackground:white;\n\tborder: 1px solid black;\n}\n\n.termsAndCondCloseDiv {\n\twidth:30px;\n\theight:30px;\n\tposition:relative;\n\tbackground:#960707;\n\tfloat:right;\n}\n\n.hamBugMenuDisplay {\n\tdisplay:block;\n}\n\n@media only screen and (min-width: 600px) {\n\ta.hamBugMenuIcon{\n\t\tdisplay:none !important;\n\t}\n\t.hamBugMenuDisplay{\n\t\tdisplay:none !important;\n\t}\n}\n\n.cob-button-display {\n\tdisplay:block;\n}\n\n@media screen and (min-width: 200px) and (max-width: 900px) {\n  .cob-banner {\n      font-family: source_sans_proregular,-apple-system,blinkmacsystemfont,Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,Fira Sans,Droid Sans,Helvetica Neue,arial,helvetica,sans-serif !important;\n      font-size: 14px;\n      height: 60px;\n      color: #CCCCCC;\n      background: #0B52B2;\n      border-radius: 4px;\n      position: absolute;\n      z-index: 999;\n      display: block;\n      height: 70px;\n      width: 80%;\n  }\n\t/* .cob-button-display{\n\t\tdisplay:none !important;\n\t} */\n  .cob-button#stop {\n      text-decoration: none;\n      color: #004FB6;\n      font-weight: bold;\n      display: inline-block;\n      background: #ffffff;\n      border-radius: 4px;\n      height: 46px;\n      /* border: 1px solid #cccccc; */\n      text-decoration: none;\n      text-align: center;\n      padding: 2px 2px 5px 0px;\n      position: absolute;\n      right: 10px;\n      width: 86px;\n      margin-top: 12px;\n  }\n    .end-cob-button {\n      /* text-decoration: none;\n      color: #004FB6; */\n      font-weight: bold;\n      display: inline-block;\n      background: #ffffff;\n      border-radius: 4px;\n      height: 46px;\n      border: 1px solid #cccccc;\n      text-decoration: none;\n      text-align: center;\n      /* margin-top: 15px; */\n      padding: 2px 2px 5px 0px;\n      position: absolute;\n      right: 110px;\n      width: 86px;\n      margin-top: 12px;\n  }\n  .cob-agent-message {\n    font-family: Arial,Verdana,sans-serif;\n    font-size: 14px;\n    line-height: 20px;\n    position: absolute;\n    text-align: center;\n    vertical-align: ce;\n    width: calc(100% - 200px);\n    align-items: center;\n    padding: 0px 5px;\n    display: flex;\n    height: 100%;\n  }\n}\n\n@media screen and (max-width: 530px) {\n  .cob-agent-message {\n    font-family: Arial,Verdana,sans-serif;\n    font-size: 12px;\n    line-height: 16px;\n  }\n}\n\n.hamBugMenuBox {\n\tz-index:1000000;\n\tfont-weight:bold;\n\tfont-size:0.8em;\n\twidth:50%;\n\tbackground:#f1f1f1;\n\tposition:fixed;\n\ttext-align:left;\n\tfont-size:12px;\n\tbottom:32px;\n\tmargin-left:5px;\n}\n\na.hamBugMenuIcon {\n\tbackground: url(\"mobMenu.png\") no-repeat scroll 0 4px #960707;\n\tfloat: left;\n\tfont-size: 0;\n\theight: 32px;\n\twidth: 27px;\n}\n.hamBugMenuBox ul {\n\tmargin-left: 0;\n\tpadding: 0;\n\tlist-style-type: none;\n\tlist-style-image: none;\n\twidth:100%\n}\n.hamBugMenuBox li {\n\tdisplay: block;\n\tpadding:15px 0 15px 15px;\n\tborder-bottom:#dddddd 1px solid;\n}\n</style>"}},{id:10006248,messages:{"cobrowseBanner_hash":"ce1024b7589cd56fbd61780b83904783","customerAcceptsSharedControl":"Customer accepts shared control","agentEndCobrowseSession":"Agent ends CoBrowse","cobrowseUnexpectedFail":"CoBrowse has been failed and closed unexpectedly","customerDeclinesCobrowse":"Customer declines CoBrowse invitation","cobrowseEnableMinimizeRestore":"false","customerEndCobrowseSession":"Customer ends CoBrowse","cobrowseSuppressed":"CoBrowse has been suppressed on this page. (cobrowse is stopped on the page)","enableCobrowseHighlight":"true","customerAcceptsCobrowse":"Customer accepts CoBrowse invitation","customerDeclinesSharedControl":"Customer declines shared control","cobrowseTestSuccess":"Cobrowse client performance test is finished successfully","cobrowseTestFail":"Cobrowse client performance test has been failed","cobrowseBanner":"<div class=\"cob-banner cob-banner-bottom\" id=\"tcCob\" style=\"\" aria-live=\"polite\">\n    <section class=\"mainContent\">\n    <div class=\"cob-agent-message\" id=\"agentNotConnected\" style=\"display:none;\" aria-hidden=\"true\">\n        You\'re no longer connected\n    </div>\n    <div class=\"cob-agent-message\" id=\"agentAssisted\" style=\"color: #ffffff;\" onclick=\"(inqFrame.Inq.CBC).toggleMenuBoxForCobBanner();\" tabindex=\"0\">\n       <div>\n        You are currently sharing your screen with the Aviva Help &amp Support Team. <a class=\"cob-button\" href=\"#\" id=\"terms-conditions\" onclick=\"window.open(\'https://media-eu2.inq.com/media/sites/10006020/flash//aviva-dsk_cobrowse/Co-Browse-TERMS&CONDITIONS.html\',\'terms_conditions\',\'toolbar=no,location=no,menubar=no,status=no,scrollbars=yes,resizable=1,height=660,width=615\');return false;\"></span>Terms &#38; Conditions</a>\n      </div>\n    </div>\n    <!--\n    <div class=\"cob-agent-message hamBugMenuDisplay\" onclick=\"(inqFrame.Inq.CBC).toggleMenuBoxForCobBanner();\">\n        <a class=\"hamBugMenuIcon highlight\" </a>\n    </div>\n    -->\n    <div>\n        <a class=\"end-cob-button\" href=\"#\" id=\"stop\" onclick=\"(inqFrame.Inq.CBC).stop(); return false;\">Stop screen sharing</a>\n    </div>\n    <div class=\"cob-ui-buttons cob-button-display\">\n        <a class=\"cob-button\" href=\"#\" id=\"stop\" onclick=\"(inqFrame.Inq.CBC).stop(); inqFrame.Inq.FlashPeer.ciActionBtnCloseChat(); return false;\">End chat session</a>\n    </div>\n</div>\n\n<!-- <div class=\"hamBugMenuBox\" id=\"hamBugMenuBoxId\" style=\"display:none;\">\n    <ul class=\"accordion\" style=\"margin:0;background:#2380D2;\">\n        <li class=\"\" style=\"background:#2380D2;\">\n            <a href=\"#\" id=\"stop\" style=\"color:#ffffff;\" onclick=\"(inqFrame.Inq.CBC).stop(); return false;\">Stop screen sharing</a>\n        </li>\n        <li class=\"\" style=\"background:#2380D2;\">\n            <a href=\"#\" style=\"color:#ffffff;\" onclick=\"(inqFrame.Inq.CBC).stop(); inqFrame.Inq.FlashPeer.ciActionRestoreAndExitChat(); return false;\" >End chat session</a>\n        </li>\n        <li class=\"\" style=\"background:#2380D2;\">\n            <a href=\"#\" id=\"terms-conditions\" style=\"color:#ffffff;\" >Terms &#38; Conditions</a>\n        </li>\n    </ul>\n  </div>-->\n\n\n<div class=\"termsAndCondDiv\" id=\"termsAndCondId\" style=\"display:none;\">\n    <div class=\"termsAndCondCloseDiv\">\n        <a href=\"\" onclick=\"(inqFrame.Inq.CBC).toggleTermsAndConditionDivForCobBanner();return false;\"><img aria-hidden=\"true\" src=\"https://media-eu2.inq.com/media/sites/10006020/flash//aviva-dsk_cobrowse/Co-Browse-TERMS&CONDITIONS.html\" style=\"wi