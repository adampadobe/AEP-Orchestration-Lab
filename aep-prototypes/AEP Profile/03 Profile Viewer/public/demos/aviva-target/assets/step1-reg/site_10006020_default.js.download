-image:url(bg_left_green.png);\n}\n.cob-user-connected .cob-user-ui-right {\n\tbackground-image:url(bg_right_green.png);\n}\n.cob-user-connected .cob-user-ui-mid {\n\tbackground-image:url(bg_mid_green.png);\n}\n.ie6 .cob-user-connected .cob-user-ui-left, .ie6 .cob-user-connected .cob-user-ui-right {\n\tbackground-image:url(bg_mid_green.png);\n}\n.cob-agent-message {\n    font-family: Arial,Verdana,sans-serif;\n    font-size: 16px;\n    line-height: 20px;\n    position: absolute;\n    text-align: center;\n    vertical-align: ce;\n    width: calc(100% - 431px);\n    align-items: center;\n    padding: 0px 20px;\n    display: flex;\n    height: 100%;\n}\n.cob-user-connected .cob-agent-message {\n    color: #CCCCCC;\n}\n.cob-user-ui a.cob-button {\n    display: inline-block;\n    color: #CCCCCC;\n    text-decoration: none;\n    font-family: Helvetica,Arial,\'Helvetica Neue\',sans-serif;\n    font-size: 11px;\n    font-weight: bold;\n    position: absolute;\n    top: 5px;\n}\n.cob-user-ui a.cob-button-disabled {\n\tdisplay:none;\n}\n.cob-icon {\n\tbackground-position:0;\n\tbackground-repeat:no-repeat;\n\tborder:none;\n\tdisplay:inline-block;\n\theight:16px;\n\twidth:16px;\n\tmargin:0 5px 0 0;\n\tpadding:0;\n\tposition:relative;\n\ttop:5px;\n\t*top:2px;/*IE*/\n}\n\n.cob-user-connected a.cob-button {\n    color: #CCCCCC;\n}\n.end-cob-button {\n        text-decoration: none;\n\t    color: #004FB6;\n\t    font-weight: bold;\n\t\tdisplay: inline-block;\n\t\tbackground: #ffffff;\n\t\tborder-radius: 4px;\n\t\theight: 55px;\n\t\tborder: 1px solid #cccccc;\n\t    text-decoration: none;\n\t    text-align: center;\n\t    margin-top: 15px;\n\t    padding: 14px 30px 0 30px;\n\t    position: absolute;\n\t    right: 230px;\n}\n.cob-button#stop {\n        text-decoration: none;\n\t    color: #004FB6;\n\t    font-weight: bold;\n\t\tdisplay: inline-block;\n\t\tbackground: #ffffff;\n\t\tborder-radius: 4px;\n\t\theight: 55px;\n\t\tborder: 1px solid #cccccc;\n\t    text-decoration: none;\n\t 