_satellite.__registerScript('https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RC335dfac72bbb43daae763ae980704256-source.min.js', "<!-- \nStart of global snippet: Please do not remove\nPlace this snippet between the <head> and </head> tags on every page of your site.\n-->\n<!-- Global site tag (gtag.js) - Google Marketing Platform -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=DC-1268437\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n\n  gtag('config', 'DC-1268437');\n  gtag('config', 'AW-1022739819');\n</script>\n<!-- End of global snippet: Please do not remove --><!--\nEvent snippet for GI_MOT_CQUO on https://www.direct.aviva.co.uk/quote/Direct/Motor/Quote/YourQuote: Please do not remove.\nPlace this snippet on pages with events that you’re tracking. \nCreation date: 07/30/2020\n-->\n<script>\n   (function () {\n    //Get all vars, defaulting to empty string or array if missing\n    var quoteValue = _satellite.getVar(\"dd-acquisition-insurance-quoteValue\") || \"\";\n    var transactionId = _satellite.getVar(\"dd-acquisition-insurance-QID\") || \"\";\n    var sessionId = _satellite.getVar(\"dd-form-sessionID\") || \"\";\n    var postcode = _satellite.getVar(\"dd-acquisition-customer-postCode\") || \"\";\n    var age = _satellite.getVar(\"dd-acquisition-customer-age-integer\") || \"\";\n    var gender = _satellite.getVar(\"dd-acquisition-customer-gender\") || \"\";\n    var numCars = _satellite.getVar(\"dd-acquisition-insurance-numCars\") || \"\";\n    var indexRank = _satellite.getVar(\"Motor Gtag Index Rank - Thank You Page\") || \"\";\n\n    var sendTo = \"DC-1268437/nudmotsa/nudmotqu+transactions\";\n\n    try {\n      //Log intent and fire the purchase event\n      _satellite.logger.info(\"Quote purchase event\", {\n        transactionId: transactionId,\n        value: quoteValue\n      });\n\n      gtag(\"event\", \"purchase\", {\n        allow_custom_scripts: true,\n        value: quoteValue,\n        transaction_id: transactionId,\n        u2: age,\n        u3: gender,\n        u6: numCars,\n        u13: postcode,\n        u42: indexRank,\n        u43: quoteValue,\n        u100: sessionId,\n        send_to: sendTo\n      });\n    } catch (e) {\n      //Report any errors cleanly\n      _satellite.logger.error(\"Quote snippet error: \" + e.message);\n    }\n  })();\n  gtag('event', 'conversion', {\n    'send_to': 'AW-1022739819/NPIgCIS_nvICEOuK1-cD'\n  });\n</script>\n<!-- End of event snippet: Please do not remove -->");