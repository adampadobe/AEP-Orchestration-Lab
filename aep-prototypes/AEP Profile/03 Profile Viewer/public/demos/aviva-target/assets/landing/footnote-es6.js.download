define([],()=>class{constructor(t,e){this.el=t,this.defaults={selectors:{citation:".a-footnote-citation",footnote:".a-footnote__item"},classes:{loaded:"footnote-loaded",footnoteBackLink:"a-footnote__back-link"},attributes:{footnoteText:"data-footnote-text"}},this.settings=Object.assign(this.defaults,e),this.selectors=this.settings.selectors,this.classes=this.settings.classes,this.attributes=this.settings.attributes,this.citationLinks=document.querySelectorAll(this.selectors.citation),this.footnoteLinks=document.querySelectorAll(this.selectors.footnote),this.footnoteText=this.el.getAttribute(this.attributes.footnoteText)}init(){return!!this.el&&(this.handleFootnote(),this.handleCitation(),this.el.classList.add(this.settings.classes.loaded),this)}handleCitation(){let i=[];this.citationLinks.forEach(t=>{let e=t.href?t.href.split("#")[1]:t.dataset.hash;i[e]||(i[e]=[]);var s=i[e].push(t);t.id=e+"-"+s,t.addEventListener("click",()=>{document.querySelector(`#${e} .a-footnote__back-link`).href="#"+t.id})})}handleFootnote(){this.footnoteLinks.forEach(t=>{t.idNumber=t.id.replace("footnote-",""),t.link=document.createElement("a"),t.link.classList.add(this.classes.footnoteBackLink),t.setAttribute("title","Footnote for citation "+t.idNumber),t.link.innerHTML=`<span class="u-hidden--visually">${this.footnoteText} ${t.idNumber}</span>`,t.append(t.link),t.link.href=`#${t.id}-1`})}});