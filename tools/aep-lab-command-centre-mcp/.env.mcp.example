# Copy to .env.mcp (gitignored) and fill in your own MCP API key.
# Generate/rotate a key at Profile Viewer → MCP servers (or POST /api/lab/mcp-keys while signed in).
# Never commit .env.mcp.

AEP_LAB_MCP_API_KEY=
# Optional — defaults to the deployed lab.
AEP_LAB_API_ORIGIN=https://aep-orchestration-lab.web.app
