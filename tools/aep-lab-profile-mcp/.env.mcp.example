# Copy to .env.mcp (gitignored) — never commit secrets.
#
# Required: shared secret Coworker sends as header X-AEP-Lab-Mcp-Key on every MCP request.
# All tools (including provisioning) use this single key.
AEP_LAB_MCP_API_KEY=
AEP_LAB_COMMERCE_OPTIMIZER_INTERNAL_KEY=

# Lab Firebase Hosting origin (no trailing slash).
AEP_LAB_API_ORIGIN=https://aep-orchestration-lab.web.app

# Brand scraper analyze uses direct Cloud Function URL (540s timeout). Optional override:
# AEP_LAB_BRAND_SCRAPER_CF_ORIGIN=https://us-central1-aep-orchestration-lab.cloudfunctions.net

# Comma-separated sandbox names MCP tools may target (case-insensitive) — env fallback when no Firestore ACL doc.
AEP_LAB_MCP_ALLOWED_SANDBOXES=apalmer,kirkham

# Phase 2 — batch job store: firestore (default on Cloud Run with ADC) or memory (local dev).
# AEP_LAB_MCP_BATCH_STORE=memory

# Phase 2 — delay between batch profile generates (ms, default 500, max 5000).
# AEP_LAB_MCP_BATCH_DELAY_MS=500

# Phase 3 — set off locally to skip Firestore audit + ACL reads.
# AEP_LAB_MCP_FIRESTORE=off

# MCP HTTP listen port (Cloud Run sets PORT=8080).
PORT=8080

# Optional: bind host (default 0.0.0.0 for Cloud Run; use 127.0.0.1 for local-only).
# HOST=127.0.0.1

# Phase 3.5 OAuth (not used — scaffold only):
# AEP_LAB_MCP_OAUTH_ISSUER=
# AEP_LAB_MCP_OAUTH_AUDIENCE=

# Weather tools (/mcp/weather): OpenWeatherMap API key. https://openweathermap.org/api
OPENWEATHER_API_KEY=

# lab_weather_map: Google Maps API key restricted to the Static Maps + Geocoding APIs only.
GOOGLE_MAPS_API_KEY=

# lab_weather_map's embed_url: separate Google Maps API key restricted to the Maps Embed
# API only. Designed to be exposed publicly in the iframe it authorizes.
GOOGLE_MAPS_EMBED_API_KEY=

# Firefly Image 5 tools (/mcp/firefly): server-to-server Adobe credentials.
# Bind these from Secret Manager in Cloud Run; never commit their values.
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=
FIREFLY_SCOPES=openid,AdobeID,read_organizations,firefly_api,ff_apis,ee.express_api
# Optional per-product overrides when the Console-generated scope list differs.
CREATIVITY_PHOTOSHOP_SCOPES=openid,AdobeID,read_organizations
CREATIVITY_INDESIGN_SCOPES=openid,AdobeID,creative_sdk,firefly_api,ff_apis
CREATIVITY_SUBSTANCE_SCOPES=openid,AdobeID,read_organizations,email,firefly_api,firefly_enterprise,profile,substance3d_api.spaces.create,substance3d_api.jobs.create
CREATIVITY_EXPRESS_SCOPES=openid,AdobeID,ee.express_api
CREATIVITY_ILLUSTRATOR_SCOPES=openid,AdobeID,creative_sdk,firefly_api,ff_apis
