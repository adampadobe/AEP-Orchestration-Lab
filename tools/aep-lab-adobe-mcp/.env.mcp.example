# Copy to .env.mcp (gitignored) and fill ADOBE_CLIENT_SECRET from Developer Console.
# Never commit .env.mcp.

ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_IMS_ORG=
ADOBE_SCOPES=openid AdobeID email profile additional_info.roles additional_info.projectedProductContext commerce.accs org.read
ADOBE_SANDBOX_NAME=prod

# Adobe Commerce as a Cloud Service instance details from Commerce Cloud Manager.
ADOBE_COMMERCE_REST_ENDPOINT=https://na1-sandbox.api.commerce.adobe.com/YOUR_INSTANCE_ID
ADOBE_COMMERCE_GRAPHQL_ENDPOINT=https://na1-sandbox.api.commerce.adobe.com/YOUR_INSTANCE_ID/graphql
ADOBE_COMMERCE_STORE=default
