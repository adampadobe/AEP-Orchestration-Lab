{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adobe/experience-design-chain/storyboard.schema.json",
  "title": "Normalized Storyboard",
  "description": "The typed contract between the Story Agent (Solution 1) and the Experience Builder (Solution 2). Mirrors experience-story-writer/references/07_storyboard.md. The builder consumes the VALIDATED JSON; the human-readable .md is a rendering of the same data. Field-level content checks (placeholders, empty exact-copy, conditional image prompt) live in validate_storyboard.py.",
  "type": "object",
  "required": ["meta", "persona", "background", "story_steps", "conclusion"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["slug", "customer", "story_type"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "customer": { "type": "string", "minLength": 1 },
        "story_type": { "type": "string", "enum": ["customer-journey", "marketer", "re-skin"] },
        "url": { "type": "string" },
        "schema_version": { "type": "string" }
      }
    },
    "persona": {
      "type": "object",
      "required": ["who", "description", "needs_and_constraints", "visual_guidance"],
      "properties": {
        "who": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "needs_and_constraints": { "type": "string", "minLength": 1 },
        "visual_guidance": {
          "type": "object",
          "required": ["environment", "appearance_and_styling", "tone_and_atmosphere"],
          "properties": {
            "environment": { "type": "string", "minLength": 1 },
            "appearance_and_styling": { "type": "string", "minLength": 1 },
            "tone_and_atmosphere": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "background": {
      "type": "object",
      "required": ["who", "scenario", "motivation", "channel", "key_message", "visual_direction"],
      "properties": {
        "who": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "motivation": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 },
        "key_message": { "type": "string", "minLength": 1 },
        "visual_direction": {
          "type": "object",
          "required": ["environment", "time_of_day", "device_platform_visible", "mood"],
          "properties": {
            "environment": { "type": "string", "minLength": 1 },
            "time_of_day": { "type": "string", "minLength": 1 },
            "device_platform_visible": { "type": "string", "minLength": 1 },
            "mood": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "story_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "title", "who", "intent", "action", "channel_touchpoint", "visual_direction"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "who": { "type": "string", "minLength": 1 },
          "intent": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "channel_touchpoint": { "type": "string", "minLength": 1 },
          "visual_direction": {
            "type": "object",
            "required": ["on_screen_copy", "primary_focus", "action_on_screen", "ui_product_visibility", "mood_tone", "key_highlight"],
            "properties": {
              "on_screen_copy": { "type": "string", "minLength": 1, "description": "EXACT verbatim on-screen copy. Never a summary or placeholder." },
              "primary_focus": { "type": "string", "minLength": 1 },
              "action_on_screen": { "type": "string", "minLength": 1 },
              "ui_product_visibility": { "type": "string", "minLength": 1, "description": "Routing track: customer-app vs Adobe-UI vs orchestration panel." },
              "mood_tone": { "type": "string", "minLength": 1 },
              "key_highlight": { "type": "string", "minLength": 1 },
              "image_generation_prompt": { "type": "string", "description": "Required UNLESS asset_supplied is true. Should include subject/setting/mood/lighting/composition/AR/negatives." },
              "asset_supplied": { "type": "boolean", "description": "true when a real screenshot/asset already covers this scene (e.g. Figma rebrand), which waives image_generation_prompt." }
            }
          },
          "type_specific": {
            "type": "object",
            "description": "Optional. journey → profile_events, segments_added · marketer → adobe_product, agent_ai_moment, business_value.",
            "additionalProperties": true
          }
        }
      }
    },
    "conclusion": {
      "type": "object",
      "required": ["outcome", "emotional_payoff", "brand_role", "visual_direction"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "emotional_payoff": { "type": "string", "minLength": 1 },
        "brand_role": { "type": "string", "minLength": 1 },
        "visual_direction": {
          "type": "object",
          "required": ["what_is_shown", "primary_focus", "action", "mood", "key_highlight"],
          "properties": {
            "what_is_shown": { "type": "string", "minLength": 1 },
            "primary_focus": { "type": "string", "minLength": 1 },
            "action": { "type": "string", "minLength": 1 },
            "mood": { "type": "string", "minLength": 1 },
            "key_highlight": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "asset_inventory": {
      "type": "array",
      "description": "Every image slot the deck needs (incl. slots inside embedded mockups). Authored during normalize; every entry must be status=resolved before build.",
      "items": {
        "type": "object",
        "required": ["slot_id", "source", "status"],
        "properties": {
          "slot_id": { "type": "string", "minLength": 1 },
          "where": { "type": "string" },
          "description": { "type": "string" },
          "source": { "type": "string", "enum": ["repo", "firefly", "stock", "brand", "supplied"] },
          "status": { "type": "string", "enum": ["unresolved", "resolved"] }
        }
      }
    }
  }
}
