erand:"%Profile - Email%"},timeout:2e3}],actions:[{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%XDM - Form Abandoned%",type:"web.formFilledOut",instanceName:"alloy"},timeout:2e3,delayNext:!0}]},{id:"RL62b3d0c607674080aad4755b13cfaf1e",name:"Form Step",events:[{modulePath:"core/src/lib/events/customEvent.js",settings:{type:"form-step",bubbleFireIfParent:!0,bubbleFireIfChildFired:!0},ruleOrder:50}],conditions:[],actions:[{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%XDM - Form Step%",type:"form.step",instanceName:"alloy"},timeout:2e3,delayNext:!0}]},{id:"RL766c3573f06e48de93b4392397fc0d74",name:"Form Submit",events:[{modulePath:"core/src/lib/events/customEvent.js",settings:{type:"form-submit",bubbleFireIfParent:!0,bubbleFireIfChildFired:!0},ruleOrder:50}],conditions:[],actions:[{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%XDM - Form Submit%",type:"form.submit",instanceName:"alloy"},timeout:2e3,delayNext:!0}]},{id:"RL80c53cbb79224fe093f1882a8fcbb7c0",name:"Display Consent Dialog",events:[{modulePath:"core/src/lib/events/pageBottom.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/customCode.js",settings:{source:function(){return null==_satellite.cookie.get("consent")}},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"<style>\n  /* The Modal (background) */\n.modal {\n  display: none; /* Hidden by default */\n  position: fixed; /* Stay in place */\n  z-index: 1; /* Sit on top */\n  padding-top: 100px; /* Location of the box */\n  left: 0;\n  top: 0;\n  width: 100%; /* Full width */\n  height: 100%; /* Full height */\n  overflow: auto; /* Enable scroll if needed */\n  background-color: rgb(0,0,0); /* Fallback color */\n  background-color: rgba(0,0,0,0.4); /* Black w/ opacity */\n}\n  /* Modal Content */\n.modal-content {\n  background-color: #fefefe;\n  margin: auto;\n  padding: 20px;\n  border: 1px solid #888;\n  width: 80%;\n}\n\n/* The Close Button */\n.close {\n  color: #aaaaaa;\n  float: right;\n  font-size: 28px;\n  font-weight: bold;\n}\n\n.close:hover,\n.close:focus {\n  color: #000;\n  text-decoration: none;\n  cursor: pointer;\n}\n</style>\n<script>_satellite.setDebug(true);</script>",language:"html"},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:'<div id="consentModal" class="modal"> \n  <!-- Modal content --> \n  <div class="consentmodal-content" style="position:fixed; width:100%; height:150px; background-color:#FFFFFF; padding:15px; bottom:0px;"> \n    <span class="close">&times;</span> \n    <p style="bold">By clicking "Allow All", you agree to the storing of cookies on your device to enhance site navigation, analyze site usage, and assist in our marketing efforts. <a href="#">Cookie Notice</a></p>   \n    <div style="margin-top:15px"> <!--style="float:left"-->\n      <a id="allow" class="btn_1 action_btn" style="border-radius: 6px;margin-right:10px" href="#">Allow All</a>\n      <a id="disable" class="btn_3 action_btn" style="border-radius: 6px;" href="#">Disable All</a>\n\n    </div>\n  </div> \n</div>\n<script>\n  var modal = document.getElementById("consentModal");\n  var span = document.getElementsByClassName("close")[0];\n  var allow = document.getElementById("allow");\n  var disable = document.getElementById("disable");\n  \n  modal.style.display = "block";\n  span.onclick = function() {\n    modal.style.display = "none";\n  }\n  window.onclick = function(event) {\n    if (event.target == modal) {\n      modal.style.display = "none";\n    }\n  }\n  allow.onclick = function(){\n    _satellite.logger.log(\'you clicked allow!\');\n    \n    alloy("setConsent", {\n    consent: [{\n      standard: "Adobe",\n      version: "1.0",\n      value: {\n        general: "in"\n      }\n    }]\n});\n\n    \n    _satellite.cookie.set("consent",true);\n\n _satellite.getVar("ECID")    \n    modal.style.display = "none";\n  }\n  disable.onclick = function(){\n    _satellite.logger.log(\'you clicked disable!\');\n    \n    alloy("setConsent", {\n    consent: [{\n      standard: "Adobe",\n      version: "1.0",\n      value: {\n        general: "out"\n      }\n    }]\n});\n    if(typeof adobe !=="undefined") adobe.optIn.denyAll();\n    \n    _satellite.cookie.set("consent",false);\n\n    \n    modal.style.display = "none";\n  }\n  \n  \n</script>',language:"html"},timeout:2e3,delayNext:!0}]},{id:"RL92359b60a82c4482900d83c6d6d4596e",name:"Transfer Funds",events:[{modulePath:"core/src/lib/events/customEvent.js",settings:{type:"transfer-funds-form-submit",bubbleFireIfParent:!0,bubbleFireIfChildFired:!0},ruleOrder:50}],conditions:[],actions:[{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%XDM - Generic Event%",type:"fsi.transferFunds",instanceName:"alloy"},timeout:2e3,delayNext:!0}]},{id:"RL961b24f2746842c3bc8c495f0141fbca",name:"Send Partner Data",events:[{modulePath:"core/src/lib/events/customEvent.js",settings:{type:"page-view",bubbleFireIfParent:!0,bubbleFireIfChildFired:!0},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"isTruthy"},leftOperand:"%Partner Data - PartnerID%"},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/60e5fd51ad90/4bfd6133e95d/5abb33f5ffd1/RCd0cd523ffd1544b49034e847e47b2340-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0},{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%XDM - Partner Data%",instanceName:"alloy",renderDecisions:!0},timeout:2e3,delayNext:!0}]},{id:"RL9d6efd714d1c4f999b9740ff135bc191",name:"Get Partner Data",events:[{modulePath:"core/src/lib/events/pageBottom.js",settings:{},ruleOrder:50}],conditions:[],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{global:!0,source:"function setDataLayer(jsonData) {\n\n  dataLayer.partnerData = jsonData;\n\n}\n\n// Function to fetch JSON data from the provided URL\nfunction fetchDataFromURL(url) {\n  return fetch(url)\n    .then(response => response.json())\n    .catch(error => {\n      console.error('Error fetching JSON data from', url, ':', error);\n    });\n}\n\n// Function to set the chosen URL in session storage\nfunction setChosenURL(url) {\n  sessionStorage.setItem('chosenURL', url);\n}\n\n// Function to get the chosen URL from session storage\nfunction getChosenURL() {\n  return sessionStorage.getItem('chosenURL');\n}\n\nconst url1 =\n  \"https://demo-system-next.s3.amazonaws.com/partner-service/FSI-PartnerID.json\";\nconst url2 =\n  \"https://demo-system-next.s3.amazonaws.com/partner-service/FSI-PartnerID2.json\";\n\n// Get the previously chosen URL from session storage (if any)\nconst chosenURLFromSession = getChosenURL();\n\n// If the chosen URL is not stored in session storage, randomly choose one of the URLs in 50%-50% mode\nconst chosenURL = chosenURLFromSession || (Math.random() < 0.5 ? url1 : url2);\n\n\nfetchDataFromURL(chosenURL)\n  .then(data => {\n    // Update the data layer with the JSON data from the chosen URL\n    setDataLayer(data);\n\n    if (!chosenURLFromSession) {\n      setChosenURL(chosenURL);\n    }\n  });\n",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLc7d1ff4bbf104acf917d4fc610268d44",name:"Set Up Auto Save",events:[{modulePath:"core/src/lib/events/customEvent.js",settings:{type:"auto-save-form-submit",bubbleFireIfParent:!0,bubbleFireIfChildFired:!0},ruleOrder:50}],conditions:[],actions:[{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%XDM - Set Up Auto Save%",type:"web.fsi.autoSaveSetUp",instanceName:"alloy"},timeout:2e3,delayNext:!0}]},{id:"RLcafbbb34c8b94a3e8698b6f90704385b",name:"Display Offer (Experience Decisioning)",events:[{modulePath:"adobe-alloy/dist/lib/events/sendEventComplete/index.js",settings:{},ruleOrder:50}],conditions:[],actions:[{modulePath