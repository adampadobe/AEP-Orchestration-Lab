source:'<!-- OneTrust TEST Script Loader -->\n<script\n  src="https://cdn-ukwest.onetrust.com/scripttemplates/otSDKStub.js"\n  type="text/javascript"\n  charset="UTF-8"\n  data-domain-script="4b323e28-b5f2-4564-8d7c-fbb689014cca-test"\n  data-write-cookie="true">\n</script>\n\n<!-- OneTrust TEST Wrapper -->\n<script>\n/* ---------------------------------------------------------------------------\n   OneTrust Wrapper (TEST)\n   - Single entrypoint: OptanonWrapper (official OneTrust callback)\n   - No DOMContentLoaded/load fallbacks (prevents duplicate firing)\n   - Purge (by mapping) before any tag rules run\n   - Run-once guard per cycle; delayed first flush to de-bounce initial OT signals\n--------------------------------------------------------------------------- */\n\n/* Debug logging (TEST only) */\nwindow.__OT_DEBUG = true;\n\n(function () {\n  var S = (window.__AVIVA_PRIVACY = window.__AVIVA_PRIVACY || {\n    last: ",",\n    tries: 0,\n    max: 120,\n    delay: 100,\n    flushing: false,\n    ranOnce: false\n  });\n\n  function nrm(s) {\n    if (!s) return ",";\n    var a = s.toUpperCase().split(",").filter(Boolean).sort();\n    return "," + a.join(",") + ",";\n  }\n\n  function getG() {\n    var gStr = window.OnetrustActiveGroups || window.OptanonActiveGroups;\n    if (gStr) return nrm(gStr);\n\n    var m = document.cookie.match(/(^|;)\\s*OptanonConsent=([^;]+)/);\n    if (!m) return ",";\n    try {\n      var d  = decodeURIComponent(m[2]);\n      var gm = d.match(/groups=([^&]+)/i);\n      if (!gm || !gm[1]) return ",";\n      var a = [], p = gm[1].split(",");\n      for (var i = 0; i < p.length; i++) {\n        var kv = p[i].split(":");\n        if (kv[1] === "1") a.push(kv[0]);\n      }\n      return nrm(a.join(","));\n    } catch (e) {\n      return ",";\n    }\n  }\n\n  function dispatch(g) {\n    var norm = nrm(g);\n    if (norm === S.last) return;\n    S.last = norm;\n\n    if (window.__OT_DEBUG) console.log("[OT TEST] Applying consent:", g);\n\n    //