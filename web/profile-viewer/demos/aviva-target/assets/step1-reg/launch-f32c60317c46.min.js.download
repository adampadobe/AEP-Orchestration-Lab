|contact-details","uk|personal|insurance|health|quote|first-year-offer","uk|personal|insurance|health|quote|core-cover","uk|personal|insurance|health|quote|customise-cover","uk|personal|insurance|health|quote|timeout","uk|personal|insurance|health|quote|current-insurer","uk|personal|insurance|health|quote|pre-existing-conditions","uk|personal|insurance|health|quote|confirm-business-type","uk|personal|insurance|health|quote|switch-statements","uk|personal|insurance|health|quote|renewal-date","uk|personal|insurance|health|quote|switch-health-questions","uk|personal|insurance|health|quote|partial-contact-match","uk|personal|insurance|health|quote|call-back-thank-you|contops","uk|personal|insurance|health|quote|call-back-thank-you|switch"]),a=_satellite.getVar("dd-pageName");return e.has(a)}}}],actions:[{modulePath:"adobe-alloy/dist/lib/actions/updateVariable/index.js",settings:{data:{web:{webInteraction:{name:"%this.getAttribute(data-dd-group)%|%this.getAttribute(data-dd-loc)%|%this.getAttribute(data-dd-link)%",type:"other",region:"body",linkClicks:{value:1}},webPageDetails:{name:"%dd-pageName%"}},_aviva:{analyticsData:{web:{page:{url:"%URL%",name:"%dd-pageName%"},user:{person:{userMDMid:"%dd-user-person-CID%"}},content:{click:"%this.getAttribute(data-dd-group)%|%this.getAttribute(data-dd-loc)%|%this.getAttribute(data-dd-link)%"}}}},identityMap:"%AEP Identity Map%"},transforms:{"":{clear:!0}},dataElementId:"DEbe0d0d08ba9d4bb79ac62f2dea6472c6",dataElementName:"XDM Variable"}},{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%XDM Variable%",type:"aepWebFormElementInteraction",instanceName:"alloy"}}]},{id:"RLaf561934aec644cda197b97b1fba615c",name:"Library Loaded (Page Top) - App Dynamics - All Environments (2)",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:2},{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"OneTrust"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/subdomain.js",settings:{subdomains:[{value:"(mobiledirect\\.qs|direct).aviva\\.co\\.uk|^(www\\.)?direct(\\d)?(-commissioning)?\\.(.{3}-|.{0})aviva\\.co\\.uk$",valueIsRegex:!0},{value:"myaviva.ukd-services.dev.aws-euw1-np.avivacloud.com",valueIsRegex:!0},{value:"(www|pre|uat|systest)\\.aviva.co.uk",valueIsRegex:!0},{value:"(myworkplace).(.{3}-|.{0})aviva\\.co\\.uk",valueIsRegex:!0},{value:"(avivahealth).(.{3}-|.{0})aviva\\.co\\.uk",valueIsRegex:!0},{value:"eng-dev-ce.guidewire.aws-euw1-np.avivacloud.com",valueIsRegex:!0},{value:"eng-extdev-ce.guidewire.aws-euw1-np.avivacloud.com",valueIsRegex:!0}]}},{modulePath:"core/src/lib/conditions/pathAndQuerystring.js",settings:{paths:[{value:"\\/insurance\\/travel\\/",valueIsRegex:!0}]},negate:!0}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"<script>\n    window['adrum-start-time'] = new Date().getTime();\n    \n    (function(config){\n        var urlAppD = window.location.href.toLowerCase();\n        // Get Path and add starting slash if missing\n        var urlPath = window.location.pathname.toLowerCase();\n        if (urlPath.substr(0,1) !== '/') {\n          urlPath = '/' + urlPath;\n        }\n        if ((urlPath.substr(0,7) === ('/quote/')) || (urlAppD.indexOf('/pda/') !== -1)) {\n        // Quote & Buy including PDA\n            // Production Commissioning\n            if (urlAppD.indexOf('commissioning.aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAE-WMV'; }\n            // Production\n            else if (urlAppD.indexOf('.aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAE-WMV'; }\n            // PreProd Commissioning\n            else if (urlAppD.indexOf('commissioning.pre-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAK-AMZ'; }\n            // PreProd\n            else if (urlAppD.indexOf('pre-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAK-AMZ'; }\n            // Runway\n            else if (urlAppD.indexOf('rwy-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAK-ANH'; }\n            // Staging\n            else if (urlAppD.indexOf('stg-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAK-AWP'; }\n            // TST Sys Test\n            else if (urlAppD.indexOf('sys-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAK-AUR'; }\n            // ENG Dev and any other stuff\n            else\n                { config.appKey = 'AD-AAB-AAK-AXA'; }\n        }\n        else if (urlAppD.indexOf('/mypayments/') !== -1) {\n        // MyPayments split\n            // Production Commissioning\n            if (urlAppD.indexOf('commissioning.aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAR-EDD'; }\n            // Production\n            else if (urlAppD.indexOf('.aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAR-EDD'; }\n            // PreProd Commissioning\n            else if (urlAppD.indexOf('commissioning.pre-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAP-VGN'; }\n            // PreProd\n            else if (urlAppD.indexOf('pre-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAP-VGN'; }\n            // Runway\n            else if (urlAppD.indexOf('rwy-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAP-VMC'; }\n            // Staging\n            else if (urlAppD.indexOf('stg-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAP-VNH'; }\n            // TST Sys Test\n            else if (urlAppD.indexOf('sys-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAP-VPD'; }\n            // ENG Dev and any other stuff\n            else\n                { config.appKey = 'AD-AAB-AAP-VJG'; }\n        }\n        else if (urlAppD.indexOf('/protection/') !== -1) {\n        // ALPS Direct Life Insurance split\n            // Production Commissioning\n            if (urlAppD.indexOf('commissioning.aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAX-JES'; }\n            // Production\n            else if (urlAppD.indexOf('.aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAX-JES'; }\n            // PreProd Commissioning\n            else if (urlAppD.indexOf('commissioning.pre-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAX-KJS'; }\n            // PreProd\n            else if (urlAppD.indexOf('pre-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAX-KJS'; }\n            // Runway\n            else if (urlAppD.indexOf('rwy-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAX-KMP'; }\n            // Staging\n            else if (urlAppD.indexOf('stg-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAX-KHV'; }\n            // TST Sys Test\n            else if (urlAppD.indexOf('sys-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAX-JJU'; }\n            // ENG Dev and any other stuff\n            else\n                { config.appKey = 'AD-AAB-AAX-KJP'; }\n        }\n        else if (urlPath.indexOf('/myfutureplanner/')!==-1) {\n            // MyFuturePlanner PROD \n            if(urlAppD.lastIndexOf('direct.aviva.co.uk/myfutureplanner/') !== -1) {\n                config.appKey = 'AD-AAB-ABF-JXA';\n            } \n            // MyFuturePlanner STG \n            else if(urlAppD.lastIndexOf('direct.stg-aviva.co.uk/myfutureplanner') !== -1) {\n                config.appKey = 'AD-AAB-ABF-BGS';\n            }\n            // MyFuturePlanner PRE \n            else if(urlAppD.lastIndexOf('direct.pre-aviva.co.uk/myfutureplanner') !== -1) {\n                config.appKey = 'AD-AAB-ABF-BHV';\n            }\n            // MyFuturePlanner RWY \n            else if(urlAppD.lastIndexOf('direct.rwy-aviva.co.uk/myfutureplanner') !== -1) {\n                config.appKey = 'AD-AAB-ABF-BJS';\n            }\n            // MyFuturePlanner ENG \n            else { config.appKey = 'AD-AAB-ABF-BFT';}\n        }\n        else if(urlPath.indexOf('/account-management-claims/')!==-1) {\n            // Customer Engage - GuideWire PROD\n            if(urlAppD.lastIndexOf('direct.aviva.co.uk/account-management-claims') !== -1) {\n                config.appKey = 'AD-AAB-ABJ-UNJ';\n            } \n            // Customer Engage - GuideWire PRE \n            else if(urlAppD.lastIndexOf('direct.pre-aviva.co.uk/account-management-claims') !== -1) {\n                config.appKey = 'AD-AAB-ABJ-DWJ';\n            }\n            // Customer Engage - GuideWire STG \n            else if (urlAppD.lastIndexOf('direct.stg-aviva.co.uk/account-management-claims') !== -1) {\n                config.appKey = 'AD-AAB-ABJ-DWG';\n            }\n            //Customer Engage - GuideWire RWY\n            else if (urlAppD.lastIndexOf('direct.rwy-aviva.co.uk/account-management-claims') !== -1) {\n                config.appKey = 'AD-AAB-ABJ-DXB';\n            }\n            //Customer Engage - GuideWire ENG\n            else if (urlAppD.lastIndexOf('eng-dev-ce.guidewire.aws-euw1-np.avivacloud.com/account-management-claims') || (urlAppD.lastIndexOf('eng-extdev-ce.guidewire.aws-euw1-np.avivacloud.com/account-management-claims') !== -1)) {\n                config.appKey = 'AD-AAB-ABJ-DWF';\n            }\n            //Customer Engage - GuideWire TEST\n            else {config.appKey = 'AD-AAB-ABJ-DVM'; }\n        }\n\t\telse if (urlAppD.indexOf('/health/') !== -1)  {\n        // MyAviva Keys\n            // Production\n            if (urlAppD.indexOf('direct.aviva.co.uk/health') !== -1)\n                { config.appKey = 'AD-AAB-ACG-HFV'; }\n            // PreProd \n            else if (urlAppD.indexOf('direct.pre-aviva.co.uk/health') !== -1)\n                { config.appKey = 'AD-AAB-ACG-CWU'; }\n            // Runway\n            else if (urlAppD.indexOf('direct.rwy-aviva.co.uk/health') !== -1)\n                { config.appKey = 'AD-AAB-ACF-XRD'; }\n            // Staging\n            else if (urlAppD.indexOf('direct.stg-aviva.co.uk/health') !== -1)\n                { config.appKey = 'AD-AAB-ACG-CUE'; }\n            // TST Sys Test\n            else if (urlAppD.indexOf('direct.sys-aviva.co.uk/health') !== -1)\n                { config.appKey = 'AD-AAB-ACG-CVS'; }\n        }\n        else if (urlAppD.indexOf('direct.') !== -1)  {\n        // MyAviva Keys\n            // Production Commissioning\n            if (urlAppD.indexOf('direct.commissioning.aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAM-HBG'; }\n            // Production\n            else if (urlAppD.indexOf('direct.aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAC-BSP'; }\n            // PreProd Commissioning\n            else if (urlAppD.indexOf('direct.commissioning.pre-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAM-HBH'; }\n            // PreProd\n            else if (urlAppD.indexOf('direct.pre-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAK-AJV'; }\n            // Runway\n            else if (urlAppD.indexOf('direct.rwy-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAJ-TCW'; }\n            // Staging\n            else if (urlAppD.indexOf('direct.stg-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAK-AVH'; }\n            // TST Sys Test\n            else if (urlAppD.indexOf('direct.sys-aviva.co.uk') !== -1)\n                { config.appKey = 'AD-AAB-AAK-AWR'; }\n            // ENG Dev and any other stuff\n            else\n                { config.appKey = 'AD-AAB-AAK-AVX'; }\n        }\n        else if (urlAppD.indexOf('myworkplace.') !== -1) {\n            // Workplace Keys \n            // Workplace Production\n            if (urlAppD.indexOf('myworkplace.aviva.co.uk') !== -1)  {   \n                config.appKey = 'AD-AAB-ABG-HEC'; \n            }\n             // Workplace PreProd                \n            else if (urlAppD.indexOf('myworkplace.pre-aviva.co.uk') !== -1) {\n                config.appKey = 'AD-AAB-ABG-HAE';\n            }\n            // Workplace RWY\n            else if (urlAppD.indexOf('myworkplace.rwy-aviva.co.uk') !== -1) {\n                config.appKey = 'AD-AAB-ABG-HEM';\n            }\n            // Workplace STG\n            else if (urlAppD.indexOf('myworkplace.stg-aviva.co.uk') !== -1) {\n                config.appKey = 'AD-AAB-ABG-HEY';\n            }\n            // Workplace SYS & ENG\n            else {\n                config.appKey = 'AD-AAB-ABG-HEB';\n            }\n        }\n        else if (urlAppD.indexOf('avivahealth.') !== -1) {\n            // PMI Q&B journey (Consumer Online) Keys \n            // Production\n            if (urlAppD.indexOf('avivahealth.aviva.co.uk') !== -1)  {   \n                config.appKey = 'AD-AAB-ABJ-MEK'; \n            }\n             // PreProd                \n            else if (urlAppD.indexOf('avivahealth.pre-aviva.co.uk') !== -1) {\n                config.appKey = 'AD-AAB-ABJ-MFF';\n            }\n            // STG\n            else if (urlAppD.indexOf('avivahealth.stg-aviva.co.uk') !== -1) {\n                config.appKey = 'AD-AAB-ABJ-MFU';\n            }\n            // SYS & ENG\n            else {\n                config.appKey = 'AD-AAB-ABJ-MFE';\n            }\n        }\n        else {\n            //Aviva Keys - combine the rule\n            if (urlAppD.indexOf('https://www.aviva.co.uk') !== -1) {\n                // Production\n                config.appKey = 'AD-AAB-AAM-CJP';\n            } else if (urlAppD.indexOf('https://www.pre-aviva.co.uk') !== -1) {\n                // PreProd\n                config.appKey = 'AD-AAB-AAM-CHF';\n            } else if (urlAppD.indexOf('https://www.rwy-aviva.co.uk') !== -1) {\n                // Runway\n                config.appKey = 'AD-AAB-AAM-CHG';\n            } else if (urlAppD.indexOf('https://www.dev-aviva.co.uk') !== -1) {\n                // Engineering\n                config.appKey = 'AD-AAB-AAM-CGU';\n            } else {\n                // Dev and any other stuff\n                config.appKey = 'AD-AAB-AAM-CJA';\n            }\n        }    \n        // AppD default position is to set spa2 to false, adding this to remember to update this when we add a SPA page in future\n        if(urlPath.indexOf('/account-management-claims/')!==-1) {\n            config.spa = {\"spa2\": true};\n        } else {\n            config.spa = {\"spa2\": false}; \n        }\n    \n        // Set up the App Dynamic locations\n        config.adrumExtUrlHttp = 'http://cdn.appdynamics.com';\n        config.adrumExtUrlHttps = 'https://cdn.appdynamics.com';\n        config.beaconUrlHttp = 'http://col.eum-appdynamics.com';\n        config.beaconUrlHttps = 'https://col.eum-appdynamics.com';\n        config.xd = {enable : true};\n        config.enablePrimaryMetrics = true;\n    \n        // Utility functions for getting data values\n        function getAppDParameter(param, url) {\n            var urlParams = url.substring(1).split('&');\n            for (var i = 0; i < urlParams.length; i++) {\n                var paramName = urlParams[i].split('=');\n                if (paramName[0] == param) {\n                    return paramName[1];\n                }\n            }\n        }    \n        function getCookieValue(a) {\n            var b = document.cookie.match('(^|;)\\\\s*' + a + '\\\\s*=\\\\s*([^;]+)');\n            return b ? b.pop() : '';\n        }    \n        function getMarketingId() {\n            var avivaMCMID,\n                AMCVCookie = getCookieValue('AMCV_5F8B76DA5233876B0A490D4D%40AdobeOrg');\n    \n            if (AMCVCookie !== '') {\n                avivaMCMID = AMCVCookie.match(/(MCMID%7C)[0-9]+/gi);\n                if (avivaMCMID !== null) {\n                    avivaMCMID = avivaMCMID[0].split('%7C')[1];\n                } else {\n                    avivaMCMID = '';\n                }\n            } else {\n                avivaMCMID = '';\n            }\n            return avivaMCMID;\n        }    \n        function getErrorVar(errorVar) {\n            var errorVal;\n            if (typeof _satellite === 'object') {\n                if (errorVar === 'code') {\n                    errorVal = _satellite.getVar('dd-page-errorCode');\n                } else if (errorVar === 'message') {\n                    errorVal = _satellite.getVar('dd-page-errorMessage');\n                }\n            }\n            return errorVal;\n        }    \n        function getDecibelId() {\n            var decibelId = '';\n            if (typeof decibelInsight === 'function') {\n                decibelId = decibelInsight('getSessionId');\n            }\n            return decibelId;\n        }    \n        function getUserData(context) {\n            var dataObj = {\n                marketingID: getMarketingId(),\n                decibelID: getDecibelId(),\n                errorCode: getErrorVar('code'),\n                errorMessage: getErrorVar('message'),\n                userPageName: document.title,           \n                formName : _satellite.getVar('dd-form-name'),\n                formSessionID : _satellite.getVar('dd-form-sessionID'),\n                pageName: _satellite.getVar('dd-pageName')\n            };\n            if (typeof context === 'object') {\n                dataObj.productCode = getAppDParameter('productCode', context.url);\n            }\n            return {\n                userData: dataObj\n            };\n        }    \n        // Pass through user data\n        // Avoid pensions as the user data conflicts with this script\n        if (urlAppD.indexOf('/uklcp') == -1) {\n            if (urlAppD.indexOf('/myportfolio') !== -1) {\n                var adrum_mj_xhrcounter = 0;\n                XMLHttpRequest.prototype.open = (function (open) {\n                    return function (method, url, async) {\n                        //Count on the MyPortfolio page\n                        if ((url.indexOf('RealtimeData') !== -1) || (url.indexOf('/MyPortfolio/Product/ProductDetailsWithVariant') !== -1)){\n                            adrum_mj_xhrcounter++;\n                            if (this.onreadystatechange) {\n                                this._onreadystatechange = this.onreadystatechange;\n                            }\n                            this.onreadystatechange = function () {\n                                if (this.readyState === 4) {\n                                    adrum_mj_xhrcounter--;\n                                    if (adrum_mj_xhrcounter === 0) {\n                                        var vpage = new ADRUM.events.VPageView({ url: document.URL + '#HomepageLoadTime' });\n                                        vpage.markVirtualPageStart(window['adrum-start-time']);\n                                        vpage.markVirtualPageEnd();\n                                        ADRUM.report(vpage);\n                                    }\n                                }\n                                if (this._onreadystatechange) {\n                                    return this._onreadystatechange.apply(this, arguments);\n                                }\n                            };\n                        }\n                        open.apply(this, arguments);\n                    };\n                })(XMLHttpRequest.prototype.open);\n            }\n\n            config.userEventInfo = {\n                'Ajax' : function(context) {\n                    if ((urlAppD.indexOf('/myportfolio') !== -1) && (context.url.indexOf('ProductDetailsWithVariant') !==-1 )) {\n                        return getUserData(context);\n                    } else {\n                        return getUserData();\n                    }\n                },\n                'PageView' : function(context) {\n                    return getUserData();\n                },\n                'VPageView' : function(context) {\n                    return getUserData();\n                }\n            };\n        }\n    })(window['adrum-config'] || (window['adrum-config'] = {}));\n    </script>\n    <script src=\"https://cdn.appdynamics.com/adrum/adrum-latest.js\"></script>",language:"html"}}]},{id:"RLaf80c167f8fe41bf9e52f9424faaeddf",name:"Page Load - Medallia Survey - DIRECT (100)",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"OneTrust"},ruleOrder:100},{modulePath:"core/src/lib/events/windowLoaded.js",settings:{},ruleOrder:100}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"contains"},leftOperand:"%OnetrustActiveGroups%",rightOperand:"C0003"}},{modulePath:"core/src/lib/conditions/subdomain.js",settings:{subdomains:[{value:"(www|pre|uat|systest)\\.aviva.co.uk",valueIsRegex:!0}]},negate:!0},{modulePath:"core/src/lib/conditions/maxFrequency.js",settings:{unit:"pageView",count:1}}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RCf1692135f60f4407b077f28cc3301d4d-source.min.js",language:"html",isExternal:!0}}]},{id:"RLafc8531bfc3d4553aa575cdd4dda091d",name:"AEP AA - DC - Update Retirement Forecast",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"forecaster_update"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"contains"},leftOperand:"%OnetrustActiveGroups%",rightOperand:"C0002"}}],actions:[{modulePath:"adobe-alloy/dist/lib/actions/updateVariable/index.js",settings:{data:{web:{webInteraction:{name:"AEP AA - DC - Update Retirement Forecast",type:"other",linkClicks:{value:1}},webPageDetails:{name:"%dd-pageName%"}}},transforms:{"":{clear:!0}},dataElementId:"DEbe0d0d08ba9d4bb79ac62f2dea6472c6",dataElementName:"XDM Variable"}},{modulePath:"adobe-alloy/dist/lib/actions/updateVariable/index.js",settings:{data:{__adobe:{analytics:{eVar2:"%URL%",eVar3:"