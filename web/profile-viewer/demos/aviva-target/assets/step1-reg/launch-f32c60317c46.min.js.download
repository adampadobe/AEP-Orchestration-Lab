ns/pathAndQuerystring.js",settings:{paths:[{value:"\\/quote\\/Direct\\/AvivaPlus\\/Quote\\/MotorCover.*",valueIsRegex:!0}]}}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RC811ae067ec2144d59debafa319f5b135-source.min.js",language:"javascript",isExternal:!0}},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RC74f22a55e02d4815a10d28d8341d1424-source.min.js",language:"javascript",isExternal:!0}}]},{id:"RL7af3dd2b5da0459698305a382427621d",name:"Page Load - Motor - Third party - Q&B Company Add Drivers (Google) (C0004) (100)",events:[{modulePath:"core/src/lib/events/windowLoaded.js",settings:{},ruleOrder:100},{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"OneTrust"},ruleOrder:100}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"contains"},leftOperand:"%OnetrustActiveGroups%",rightOperand:"C0004"}},{modulePath:"core/src/lib/conditions/pathAndQuerystring.js",settings:{paths:[{value:"/quote/Direct/Motor/Company/Quote/AddDrivers/Add",valueIsRegex:!0},{value:"/quote/Direct/Motor2/Company/Quote/AddDrivers/Add",valueIsRegex:!0}]}}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RCeb501d72dd924058b3b4011c35d7b1ee-source.min.js",language:"html",isExternal:!0}},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RC6e281a81228e4436bcb33abcf683f188-source.min.js",language:"html",isExternal:!0}}]},{id:"RL7b14d5faa071478d8286918721f13dbe",name:"Library Loaded (Page Top) - App Dynamics - Aviva Online (2)",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:2},{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"OneTrust"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/subdomain.js",settings:{subdomains:[{value:"dev1.dev.online.aviva.co.uk",valueIsRegex:!0},{value:"test.dev.online.aviva.co.uk",valueIsRegex:!0},{value:"uat.dev.online.aviva.co.uk",valueIsRegex:!0},{value:"stage.dev.online.aviva.co.uk",valueIsRegex:!0},{value:"online.aviva.co.uk",valueIsRegex:!0},{value:"(www).(.{3}-|.{0})onlineaviva.co.uk",valueIsRegex:!0}]}}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"<script>\n    window['adrum-start-time'] = new Date().getTime();\n\n    (function(config){\n        var urlAppD = window.location.href.toLowerCase();\n        // Get Path and add starting slash if missing\n        var urlPath = window.location.pathname.toLowerCase();\n        if (urlPath.substr(0,1) !== '/') {\n          urlPath = '/' + urlPath;\n        }\n\n\t\t// Production\n\t\tif (urlAppD.indexOf('www.online.aviva.co.uk') !== -1)\n\t\t\t{ config.appKey = 'AD-AAB-AAX-RHJ'; }\n\t\t// Staging\n\t\telse if (urlAppD.indexOf('www.stg-onlineaviva.co.uk') !== -1)\n\t\t\t{ config.appKey = 'AD-AAB-AAX-RGX'; }\n\t\t// Preprod\n\t\telse if (urlAppD.indexOf('www.pre-onlineaviva.co.uk') !== -1)\n\t\t\t{ config.appKey = 'AD-AAB-ACY-ACB'; }\n\t\t// Runway\n\t\telse if (urlAppD.indexOf('uat.dev.online.aviva.co.uk') !== -1)\n\t\t\t{ config.appKey = 'AD-AAB-AAX-RJW'; }\n\t\t// TST Sys Test\n\t\telse if (urlAppD.indexOf('test.dev.online.aviva.co.uk') !== -1)\n\t\t\t{ config.appKey = 'AD-AAB-AAX-RJV'; }\n\t\t// ENG Dev and any other stuff\n\t\telse\n\t\t\t{ config.appKey = 'AD-AAB-AAX-RJE'; }\n\n        // AppD default position is to set spa2 to false, adding this to remember to update this when we add a SPA page in future\n        config.spa = {\"spa2\": false};\n\n        // Set up the App Dynamic locations\n        config.adrumExtUrlHttp = 'http://cdn.appdynamics.com';\n        config.adrumExtUrlHttps = 'https://cdn.appdynamics.com';\n        config.beaconUrlHttp = 'http://col.eum-appdynamics.com';\n        config.beaconUrlHttps = 'https://col.eum-appdynamics.com';\n        config.xd = {enable : true};\n        config.enablePrimaryMetrics = true;\n\n        // Utility functions for getting data values\n        function getAppDParameter(param, url) {\n            var urlParams = url.substring(1).split('&');\n            for (var i = 0; i < urlParams.length; i++) {\n                var paramName = urlParams[i].split('=');\n                if (paramName[0] == param) {\n                    return paramName[1];\n                }\n            }\n        }\n\n        function getCookieValue(a) {\n            var b = document.cookie.match('(^|;)\\\\s*' + a + '\\\\s*=\\\\s*([^;]+)');\n            return b ? b.pop() : '';\n        }\n\n        function getMarketingId() {\n            var avivaMCMID,\n                AMCVCookie = getCookieValue('AMCV_5F8B76DA5233876B0A490D4D%40AdobeOrg');\n\n            if (AMCVCookie !== '') {\n                avivaMCMID = AMCVCookie.match(/(MCMID%7C)[0-9]+/gi);\n                if (avivaMCMID !== null) {\n                    avivaMCMID = avivaMCMID[0].split('%7C')[1];\n                } else {\n                    avivaMCMID = '';\n                }\n            } else {\n                avivaMCMID = '';\n            }\n            return avivaMCMID;\n        }\n\n        function getErrorVar(errorVar) {\n            var errorVal;\n            if (typeof _satellite === 'object') {\n                if (errorVar === 'code') {\n                    errorVal = _satellite.getVar('dd-page-errorCode');\n                } else if (errorVar === 'message') {\n                    errorVal = _satellite.getVar('dd-page-errorMessage');\n                }\n            }\n            return errorVal;\n        }\n\n        function getDecibelId() {\n            var decibelId = '';\n            if (typeof decibelInsight === 'function') {\n                decibelId = decibelInsight('getSessionId');\n            }\n            return decibelId;\n        }\n\n        function getUserData(context) {\n            var dataObj = {\n                marketingID: getMarketingId(),\n                decibelID: getDecibelId(),\n                errorCode: getErrorVar('code'),\n                errorMessage: getErrorVar('message'),\n                userPageName: document.title,           \n                formName : _satellite.getVar('dd-form-name'),\n                formSessionID : _satellite.getVar('dd-form-sessionID')\n            };\n            if (typeof context === 'object') {\n                dataObj.productCode = getAppDParameter('productCode', context.url);\n            }\n            return {\n                userData: dataObj\n            };\n        }\n\n        // Pass through user data\n        // Avoid pensions as the user data conflicts with this script\n        if (urlAppD.indexOf('/uklcp') == -1) {\n            config.userEventInfo = {\n                'Ajax' : function(context) {\n                    if ((urlAppD.indexOf('/myportfolio') !== -1) && (context.url.indexOf('ProductDetailsWithVariant') !==-1 )) {\n                        return getUserData(context);\n                    } else {\n                        return getUserData();\n                    }\n                },\n                'PageView' : function(context) {\n                    return getUserData();\n                },\n                'VPageView' : function(context) {\n                    return getUserData();\n                }\n            };\n        }\n    })(window['adrum-config'] || (window['adrum-config'] = {}));\n    </script>\n    <script src=\"//cdn.appdynamics.com/adrum/adrum-latest.js\"></script>",language:"html"}}]},{id:"RL7b497fccbb644896aff1f55515b7ae28",name:"Page Load - FNZ - Third party - Pension Transfer - Ready To Apply (LinkedIn) (C0004) (100)",events:[{modulePath:"core/src/lib/events/windowLoaded.js",settings:{},ruleOrder:100},{modulePath:"core/src/lib/events/directCall.js",settings:{identifi