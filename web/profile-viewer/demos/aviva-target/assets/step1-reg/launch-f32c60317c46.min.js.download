1c3424de2b80dd99ef646c3be",dataElementName:"Data Variable"}},{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%XDM Variable%",data:"%Data Variable%",type:"web.webinteraction.linkClicks",instanceName:"alloy"}}]},{id:"RLfaf81ff931a344ff94db0db8831f36b4",name:"Page Load - Third party - Shape My Future Landing Page (Google) (C0004) (100)",events:[{modulePath:"core/src/lib/events/windowLoaded.js",settings:{},ruleOrder:100},{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"OneTrust"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"contains"},leftOperand:"%OnetrustActiveGroups%",rightOperand:"C0004"}},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"matchesRegex"},leftOperand:"%dd-pageName%",rightOperand:"^uk\\|personal\\|retirement\\|tools-and-calculators\\|shape-my-future$"}}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RC507156a360c34342bdb49b1119827f85-source.min.js",language:"html",isExternal:!0}},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RCa825346d77bb4190b2ee03069250e27b-source.min.js",language:"html",isExternal:!0}}]},{id:"RLfc10758721e144c3a348184753772dd0",name:"GCM - Page Load - Initialisation (Google) (5)",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:5}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"equals"},leftOperand:"%GCM Path Control%",rightOperand:"fire_gcm"}}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{global:!1,source:"/**\n * @module GCM_Initialisation_google\n * @version 1.1\n * @description Adobe Launch Custom Action to initialise Google Consent Mode with default settings\n * \n * Production-ready version with optimised performance and simplified logic\n * \n * FLOW:\n * 1. ALL users get gtag('consent', 'default', ...) first\n * 2. Returning users immediately get gtag('consent', 'update', ...) after\n * 3. First-time users wait for OneTrust interaction to trigger update\n * \n * Dependencies:\n * - window.gtag: Google gtag.js tracking method\n * - _satellite.getVar: Adobe Launch data element getter\n */\n\n(function () {\n  'use strict';\n\n  // ============================================================================\n  // EARLY EXIT CHECK - Ensure minimum browser requirements\n  // ============================================================================\n  if (!window.document || !window.setTimeout) {\n    if (console && console.error) {\n      console.error('[GCM_Init_v1.1] Browser missing essential features');\n    }\n    return;\n  }\n\n  // ============================================================================\n  // CONFIGURATION\n  // ============================================================================\n  const CONFIG = {\n    LOG_PREFIX: '[GCM_Init_v1.1]',\n    DATA_ELEMENT_NAME: 'CMP Consent Settings',\n    WAIT_FOR_UPDATE: 500 // milliseconds for first-time users\n  };\n\n  // Default consent settings (privacy-first approach)\n  const DEFAULT_CONSENT = {\n    ad_storage: 'denied',\n    analytics_storage: 'denied',\n    functionality_storage: 'denied',\n    personalization_storage: 'denied',\n    ad_user_data: 'denied',\n    ad_personalization: 'denied',\n    security_storage: 'granted',\n    wait_for_update: CONFIG.WAIT_FOR_UPDATE\n  };\n\n  // Track initialisation state\n  var isInitialised = false;\n\n  // ============================================================================\n  // UTILITIES\n  // ============================================================================\n  \n  /**\n   * Check if debug mode is enabled\n   * Follows same pattern as other production files\n   */\n  const isDebugMode = function() {\n    return !!(\n      // Check URL parameter\n      (window.location.href.indexOf('_satellite_debug=true') !== -1) ||\n      // Check hostname for test environments (*.rwy-aviva)\n      window.location.hostname.match(/\\.rwy-aviva/) ||\n      // Check if _satellite debug is explicitly enabled\n      (window._satellite && window._satellite._debug === true)\n    );\n  };\n\n  /**\n   * Simple logging function - only logs in debug mode or for errors\n   */\n  const log = function(level, message, data) {\n    // Only log in debug mode or for errors\n    if (!isDebugMode() && level !== 'error') return;\n    \n    try {\n      var logger = console[level] || console.log;\n      var fullMessage = CONFIG.LOG_PREFIX + ' ' + message;\n      \n      if (data) {\n        logger(fullMessage, data);\n      } else {\n        logger(fullMessage);\n      }\n    } catch (e) {\n      // Logging failed - continue silently\n    }\n  };\n\n  /**\n   * Check if a cookie exists\n   * Simplified version without complex regex\n   */\n  const hasCookie = function(cookieName) {\n    try {\n      return document.cookie.indexOf(cookieName + '=') !== -1;\n    } catch (e) {\n      return false;\n    }\n  };\n\n  /**\n   * Check if user has previously interacted with consent banner\n   * Simplified detection logic\n   */\n  const isReturningUser = function() {\n    // Primary check: OptanonAlertBoxClosed cookie indicates banner was closed\n    if (hasCookie('OptanonAlertBoxClosed')) {\n      log('debug', 'Returning user detected (banner closed)');\n      return true;\n    }\n    \n    // Secondary check: OptanonConsent with groups indicates preferences set\n    if (hasCookie('OptanonConsent')) {\n      var cookies = document.cookie;\n      if (cookies.indexOf('OptanonConsent') !== -1 && cookies.indexOf('groups=') !== -1) {\n        log('debug', 'Returning user detected (consent set)');\n        return true;\n      }\n    }\n    \n    return false;\n  };\n\n  /**\n   * Validate consent settings object\n   * Returns true if valid, false otherwise\n   */\n  const isValidConsent = function(settings) {\n    if (!settings || typeof settings !== 'object') {\n      return false;\n    }\n    \n    // Check for at least one valid consent key\n    var validKeys = ['ad_storage', 'analytics_storage', 'functionality_storage', \n                     'personalization_storage', 'ad_user_data', 'ad_personalization'];\n    \n    for (var i = 0; i < validKeys.length; i++) {\n      var key = validKeys[i];\n      if (settings.hasOwnProperty(key) && \n          (settings[key] === 'granted' || settings[key] === 'denied')) {\n        return true;\n      }\n    }\n    \n    return false;\n  };\n\n  /**\n   * Initialise gtag and dataLayer if not present\n   */\n  const initialiseGtag = function() {\n    // Initialise dataLayer\n    if (!window.dataLayer) {\n      window.dataLayer = [];\n      log('debug', 'Initialised dataLayer');\n    }\n    \n    // Define gtag function if not present\n    if (!window.gtag) {\n      window.gtag = function() {\n        window.dataLayer.push(arguments);\n      };\n      log('debug', 'Initialised gtag function');\n    }\n  };\n\n  // ============================================================================\n  // MAIN INITIALISATION\n  // ============================================================================\n  \n  /**\n   * Main initialisation function\n   * Sets default consent for all users, then updates for returning users\n   */\n  const initialiseConsent = function() {\n    try {\n      // Prevent duplicate initialisation\n      if (isInitialised) {\n        log('debug', 'Already initialised, skipping');\n        return;\n      }\n\n      // Ensure gtag is available\n      initialiseGtag();\n\n      var userType = isReturningUser() ? 'returning' : 'first-time';\n\n      // STEP 1: ALWAYS set default consent first for ALL users\n      // This is required by Google Consent Mode\n      window.gtag('consent', 'default', DEFAULT_CONSENT);\n      log('info', 'Default consent set for ' + userType + ' user');\n\n      // STEP 2: For returning users ONLY, immediately send update\n      if (userType === 'returning') {\n        try {\n          // Get consent settings from Adobe Launch data element\n          var consentUpdate = window._satellite && window._satellite.getVar && \n                             window._satellite.getVar(CONFIG.DATA_ELEMENT_NAME);\n          \n          if (isValidConsent(consentUpdate)) {\n            // Create update payload without wait_for_update\n            var updatePayload = {};\n            for (var key in consentUpdate) {\n              if (consentUpdate.hasOwnProperty(key) && key !== 'wait_for_update') {\n                updatePayload[key] = consentUpdate[key];\n              }\n            }\n            \n            window.gtag('consent', 'update', updatePayload);\n            log('info', 'Consent updated for returning user', updatePayload);\n          } else {\n            log('warn', 'Returning user but consent settings unavailable');\n            // Default is already set, OneTrust will trigger update when ready\n          }\n        } catch (e) {\n          log('warn', 'Error getting consent settings for returning user', {error: e.message});\n          // Continue with default consent\n        }\n      } else {\n        log('info', 'First-time user, waiting for consent interaction');\n      }\n\n      isInitialised = true;\n\n      // Track in dataLayer for monitoring\n      if (window.dataLayer && Array.isArray(window.dataLayer)) {\n        try {\n          window.dataLayer.push({\n            event: 'gcm_initialised',\n            user_type: userType,\n            timestamp: Date.now()\n          });\n        } catch (e) {\n          // Non-critical, continue\n        }\n      }\n\n    } catch (error) {\n      log('error', 'Critical error during initialisation', {\n        error: error.message,\n        stack: error.stack\n      });\n    }\n  };\n\n  // ============================================================================\n  // EXECUTE INITIALISATION\n  // ============================================================================\n  \n  // Run initialisation immediately\n  initialiseConsent();\n\n  // ============================================================================\n  // DEBUG INTERFACE - Available only in debug mode\n  // ============================================================================\n  if (isDebugMode()) {\n    window._gcmInitV1_1 = {\n      version: '1.1',\n      config: CONFIG,\n      isInitialised: function() { return isInitialised; },\n      \n      // Manual re-initialisation for testing\n      reinitialise: function() {\n        isInitialised = false;\n        log('info', 'Manual reinitialisation triggered');\n        initialiseConsent();\n      },\n      \n      // Check user type\n      checkUserType: function() {\n        var userType = isReturningUser() ? 'returning' : 'first-time';\n        log('info', 'User type: ' + userType);\n        return userType;\n      },\n      \n      // Get current consent settings\n      getConsentSettings: function() {\n        try {\n          var settings = window._satellite && window._satellite.getVar && \n                        window._satellite.getVar(CONFIG.DATA_ELEMENT_NAME);\n          log('info', 'Current consent settings', settings);\n          return settings;\n        } catch (e) {\n          log('error', 'Failed to get consent settings', {error: e.message});\n          return null;\n        }\n      }\n    };\n    \n    log('debug', 'Debug tools available at window._gcmInitV1_1');\n  }\n\n})();",language:"javascript"}}]},{id:"RLfc1e28d1dd7e47ac8752e231b1e1743d",name:"Page Load - Third party - ALPS-CI-ThankYou (Bing, Facebook, Twitter, Google) (C0004) (100)",events:[{modulePath:"core/src/lib/events/windowLoaded.js",settings:{},ruleOrder:100},{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"OneTrust"},ruleOrder:100}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"contains"},leftOperand:"%OnetrustActiveGroups%",rightOperand:"C0004"}},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"matchesRegex"},leftOperand:"%dd-pageName%",rightOperand:"^uk\\|personal\\|insurance\\|ci\\|confirmation\\|thank-you$"}}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RCe6ef1c1f98b24d8aad53ae1935a91775-source.min.js",language:"javascript",isExternal:!0}},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RC43cb81f2cee04b57b827f693ae795239-source.min.js",language:"javascript",isExternal:!0}},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RC04cd879ae068466c9246cf9f9c2b1a6f-source.min.js",language:"html",isExternal:!0}},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RC260af8f5c86d4d1c89ad2f1fc6dc4b05-source.min.js",language:"html",isExternal:!0}}]},{id:"RLfd4868f1e82e4b3a9ae6a24c768052ec",name:"Page Load - Third party - Health - Your Details (Meta, Epsilon) (C0004) (100)",events:[{modulePath:"core/src/lib/events/windowLoaded.js",settings:{},ruleOrder:100},{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"OneTrust"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"contains"},leftOperand:"%OnetrustActiveGroups%",rightOperand:"C0004"}},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"matchesRegex"},leftOperand:"%dd-pageName%",rightOperand:"^uk\\|personal\\|insurance\\|health\\|quote\\|your-details$"}}],actions:[{modulePath:"core/src/lib/actions/