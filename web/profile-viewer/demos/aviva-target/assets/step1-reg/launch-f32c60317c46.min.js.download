c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RCd46313f5a74c41458af37f5816cd57d7-source.min.js",language:"javascript",isExternal:!0}}]},{id:"RLb99bd501d183489aa8d19c44ed2f9e0a",name:"GCM - Page Load - OneTrust Event Listener (10)",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:10}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"equals"},leftOperand:"%GCM Path Control%",rightOperand:"fire_gcm"}}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{global:!1,source:"/**\n * @module OneTrustBannerConsentChange_event\n * @version 1.1\n * @description Adobe Launch Event Listener for OneTrust consent changes\n * \n * Production-ready version simplified for maintainability\n * \n * This script detects when users change cookie consent and triggers\n * Adobe Launch to update Google Consent Mode immediately.\n * \n * WHAT IT DOES:\n * 1. Waits for OneTrust to be ready\n * 2. Listens for consent changes\n * 3. Triggers Direct Call Rule \"GCM_UPDATE\" immediately\n * 4. No delays - ensures consent is set before marketing tags\n */\n\n(function () {\n  'use strict';\n\n  // Check browser compatibility\n  if (!window.addEventListener || !Date.now) {\n    console.error('[OneTrust_Event_v1.1] Browser not supported');\n    return;\n  }\n\n  // ============================================================================\n  // CONFIGURATION\n  // ============================================================================\n  const CONFIG = {\n    LOG_PREFIX: '[OneTrust_Event_v1.1]',\n    DIRECT_CALL_RULE: 'GCM_UPDATE',\n    MAX_WAIT_TIME: 10000,  // 10 seconds max to find OneTrust\n    CHECK_INTERVAL: 500    // Check every 500ms\n  };\n\n  // ============================================================================\n  // STATE\n  // ============================================================================\n  const state = {\n    isReady: false,\n    isFirstConsent: true,\n    lastTriggerTime: 0\n  };\n\n  // ============================================================================\n  // DEBUG MODE DETECTION\n  // ============================================================================\n  const isDebugMode = () => {\n    return !!(\n      window.location.href.indexOf('_satellite_debug=true') !== -1 ||\n      window.location.hostname.match(/\\.rwy-aviva/) ||\n      (window._satellite && window._satellite._debug === true)\n    );\n  };\n\n  // ============================================================================\n  // LOGGING (only in debug mode or for errors)\n  // ============================================================================\n  const log = (level, message, data) => {\n    if (!isDebugMode() && level !== 'error') return;\n    \n    try {\n      const logger = console[level] || console.log;\n      const msg = `${CONFIG.LOG_PREFIX} ${message}`;\n      data ? logger(msg, data) : logger(msg);\n    } catch {\n      // Silent fail\n    }\n  };\n\n  // ============================================================================\n  // CORE FUNCTIONS\n  // ============================================================================\n  \n  /**\n   * Check if OneTrust is available\n   */\n  const isOneTrustReady = () => {\n    return !!(\n      window.OneTrust || \n      window.OnetrustActiveGroups !== undefined ||\n      document.cookie.indexOf('OptanonConsent') !== -1\n    );\n  };\n\n  /**\n   * Check if Adobe Launch is ready\n   */\n  const isSatelliteReady = () => {\n    return !!(window._satellite && typeof window._satellite.track === 'function');\n  };\n\n  /**\n   * Trigger the Adobe Launch Direct Call Rule\n   * This is the main action - tells Adobe Launch to update consent\n   */\n  const triggerUpdate = (source) => {\n    // Prevent duplicate triggers within 1 second\n    const now = Date.now();\n    if (now - state.lastTriggerTime < 1000) {\n      log('debug', 'Skipping duplicate trigger');\n      return;\n    }\n    state.lastTriggerTime = now;\n\n    // Check Adobe Launch is available\n    if (!isSatelliteReady()) {\n      log('error', 'Adobe Launch not available');\n      return;\n    }\n\n    // Get consent info for logging\n    const context = {\n      source,\n      isFirstConsent: state.isFirstConsent,\n      activeGroups: window.OnetrustActiveGroups || 'unknown'\n    };\n\n    log('info', 'Triggering consent update', context);\n    \n    // CRITICAL: Trigger Adobe Launch Direct Call Rule\n    window._satellite.track(CONFIG.DIRECT_CALL_RULE);\n    \n    // Mark first consent as complete\n    if (state.isFirstConsent) {\n      state.isFirstConsent = false;\n    }\n  };\n\n  /**\n   * Setup event listeners for OneTrust\n   */\n  const setupListeners = () => {\n    // Method 1: OneTrustGroupsUpdated event\n    window.addEventListener('OneTrustGroupsUpdated', () => {\n      log('debug', 'OneTrustGroupsUpdated fired');\n      if (state.isReady) {\n        triggerUpdate('OneTrustGroupsUpdated');\n      }\n    });\n\n    // Method 2: OptanonWrapper function\n    const originalWrapper = window.OptanonWrapper;\n    window.OptanonWrapper = function() {\n      log('debug', 'OptanonWrapper called');\n      \n      // Call original if it exists\n      if (typeof originalWrapper === 'function') {\n        try {\n          originalWrapper.apply(this, arguments);\n        } catch (e) {\n          log('error', 'Error in original OptanonWrapper', e.message);\n        }\n      }\n      \n      // Trigger update for user interactions only\n      if (state.isReady && !state.isFirstConsent) {\n        triggerUpdate('OptanonWrapper');\n      }\n    };\n\n    // Method 3: OneTrust.OnConsentChanged (if available)\n    if (window.OneTrust && typeof window.OneTrust.OnConsentChanged === 'function') {\n      try {\n        window.OneTrust.OnConsentChanged(() => {\n          log('debug', 'OneTrust.OnConsentChanged fired');\n          if (state.isReady) {\n            triggerUpdate('OneTrust.OnConsentChanged');\n          }\n        });\n      } catch (e) {\n        log('debug', 'Could not register OneTrust.OnConsentChanged');\n      }\n    }\n\n    log('info', 'Event listeners ready');\n  };\n\n  /**\n   * Initialise and wait for OneTrust\n   */\n  const initialise = () => {\n    const startTime = Date.now();\n    \n    const checkAndSetup = () => {\n      // Check if OneTrust is ready\n      if (isOneTrustReady()) {\n        log('info', 'OneTrust detected, setting up listeners');\n        setupListeners();\n        state.isReady = true;\n        \n        // Add debug interface if in debug mode\n        if (isDebugMode()) {\n          window._oneTrustDebugV1_1 = {\n            version: '1.1',\n            state,\n            triggerManual: () => triggerUpdate('manual'),\n            isOneTrustReady,\n            isSatelliteReady\n          };\n          log('debug', 'Debug interface at window._oneTrustDebugV1_1');\n        }\n        \n        return;\n      }\n      \n      // Check if we've exceeded max wait time\n      if (Date.now() - startTime > CONFIG.MAX_WAIT_TIME) {\n        log('error', 'OneTrust not found after 10 seconds');\n        \n        // Still provide manual trigger in debug mode\n        if (isDebugMode() && isSatelliteReady()) {\n          window.triggerGCMUpdate = () => triggerUpdate('manual_fallback');\n          log('warn', 'Manual trigger available at window.triggerGCMUpdate');\n        }\n        return;\n      }\n      \n      // Try again\n      setTimeout(checkAndSetup, CONFIG.CHECK_INTERVAL);\n    };\n    \n    checkAndSetup();\n  };\n\n  // ============================================================================\n  // START\n  // ============================================================================\n  log('info', 'Starting OneTrust event listener');\n  initialise();\n\n})();\n\n/**\n * === WHAT THIS DOES (FOR JUNIOR DEVELOPERS) ===\n * \n * This script is like a \"translator\" between OneTrust (cookie banner) \n * and Adobe Launch (tag manager).\n * \n * When a user clicks \"Accept All\" or changes cookie preferences:\n * 1. OneTrust fires an event\n * 2. This script catches that event\n * 3. It immediately tells Adobe Launch via _satellite.track('GCM_UPDATE')\n * 4. Adobe Launch then runs the consent update action\n * \n * KEY POINTS:\n * - NO DELAYS - Must fire before marketing tags\n * - 3 ways to detect changes (for reliability)\n * - Simple structure - easy to follow\n * - Debug mode for testing on *.rwy-aviva domains\n * \n * MAINTENANCE:\n * - To change the Direct Call Rule name: Update CONFIG.DIRECT_CALL_RULE\n * - To adjust timing: Update MAX_WAIT_TIME or CHECK_INTERVAL\n * - To add logging: Use the log() function\n * - Debug interface available at window._oneTrustDebugV1_1 in test environments\n */",language:"javascript"}}]},{id:"RLbadad08bff17407686ac02e6d40f8a93",name:"AEP AA - Page Load - p38, v83 - Retirement Planner Results (100)",events:[{modulePath:"core/src/lib/events/windowLoaded.js",settings:{},ruleOrder:100},{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"OneTrust"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"contains"},leftOperand:"%OnetrustActiveGroups%",rightOperand:"C0002"}},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"matchesRegex"},leftOperand:"%dd-pageName%",rightOperand:"^uk\\|personal\\|retirement\\|tools\\|retirement-planner\\|possible-outcomes$"}}],actions:[{modulePath:"adobe-alloy/dist/lib/actions/updateVariable/index.js",settings:{data:{web:{webInteraction:{name:"Retirement Planner Results p38 v83",type:"other",linkClicks:{value:1}},webPageDetails:{name:"%dd-pageName%"}}},transforms:{"":{clear:!0}},dataElementId:"DEbe0d0d08ba9d4bb79ac62f2dea6472c6",dataElementName:"XDM Variable"}},{modulePath:"adobe-alloy/dist/lib/actions/updateVariable/index.js",settings:{data:{__adobe:{analytics:{eVar2:"%URL%",eVar3:"%dd-pageNam