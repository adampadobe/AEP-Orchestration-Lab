exOf('mybusiness.stg-aviva.co.uk') !== -1)\n\t\t{ config.appKey = 'AD-AAB-AAN-CMF'; }   \n\t//TST Sys Test\n\telse if (urlAppD.indexOf('mybusiness.sys-aviva.co.uk') !== -1)\n\t\t{ config.appKey = 'AD-AAB-AAN-CHG'; }\n\t//ENG Dev and any other stuff\n\telse\n\t\t{ config.appKey = 'AD-AAB-AAN-CFC'; }\n\t\n\t// Set up th App Dynamic locations\n\tconfig.adrumExtUrlHttp = 'http://cdn.appdynamics.com';\n\tconfig.adrumExtUrlHttps = 'https://cdn.appdynamics.com';\n\tconfig.beaconUrlHttp = 'http://col.eum-appdynamics.com';\n\tconfig.beaconUrlHttps = 'https://col.eum-appdynamics.com';\n\tconfig.xd = {enable : true};\n\t\n})(window['adrum-config'] || (window['adrum-config'] = {}));\n\n</script>\n<script src=\"https://cdn.appdynamics.com/adrum/adrum-23.3.0.4265.js\"></script>",language:"html"}}]},{id:"RLdaef5beb02da41238b15554bd43e9e80",name:"AEP AA - DC - Quote Status & Decision  (p19 v39 p45) ",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"decision_code_refer"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"contains"},leftOperand:"%OnetrustActiveGroups%",rightOperand:"C0002"}}],actions:[{modulePath:"adobe-alloy/dist/lib/actions/updateVariable/index.js",settings:{data:{web:{webInteraction:{name:"AEP AA - DC - Quote Status & Decision (p19 v39 p45)",type:"other",linkClicks:{value:1}},webPageDetails:{name:"%dd-pageName%"}}},transforms:{"":{clear:!0}},dataElementId:"DEbe0d0d08ba9d4bb79ac62f2dea6472c6",dataElementName:"XDM Variable"}},{modulePath:"adobe-alloy/dist/lib/actions/updateVariable/index.js",settings:{data:{__adobe:{analytics:{eVar2:"%URL%",eVar3:"%dd-pageName%",prop8:"AEP AA - DC - Quote Status & Decision (p19 v39 p45)",eVar39:"%dd-acquisition-insurance-quoteStatus%",prop15:"%URL%",prop19:"%dd-acquisition-insurance-quoteStatus%",prop45:"%decisionCodeReason%",prop60:"%dd-pageName%"}}},transforms:{"__adobe.analytics":{clear:!0}},dataElementId:"DE2a98ef41c3424de2b80dd99ef646c