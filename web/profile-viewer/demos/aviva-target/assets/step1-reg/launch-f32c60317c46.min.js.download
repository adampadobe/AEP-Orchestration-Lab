ookie.match(/(^|;)\\s*OptanonConsent=([^;]+)/);\n    if (!m) return ",";\n    try {\n      var d  = decodeURIComponent(m[2]);\n      var gm = d.match(/groups=([^&]+)/i);\n      if (!gm || !gm[1]) return ",";\n      var a = [], p = gm[1].split(",");\n      for (var i = 0; i < p.length; i++) {\n        var kv = p[i].split(":");\n        if (kv[1] === "1") a.push(kv[0]);\n      }\n      return nrm(a.join(","));\n    } catch (e) {\n      return ",";\n    }\n  }\n\n  function dispatch(g) {\n    var norm = nrm(g);\n    if (norm === S.last) return;\n    S.last = norm;\n\n\n    if (window.__OT_DEBUG) console.log("[OT TEST] Applying consent:", g);\n\n    // Purge by mapping (defensive read of the data element)\n    if (typeof window.runPurge === "function") {\n      try {\n        var mapping = (window._satellite && typeof _satellite.getVar === "function") ? _satellite.getVar("Global - OneTrust - Cookie Mapping") : null;\n        if (mapping) {\n          window.runPurge(g, mapping);\n        } else if (window.__OT_DEBUG) {\n          console.warn("[OT TEST] Mapping not available; skipping purge this tick.");\n        }\n      } catch (e) {\n        if (window.__OT_DEBUG) console.warn("[OT TEST] Purge error:", e);\n      }\n    }\n  }\n\n  function flush() {\n    if (S.flushing) return;\n    S.flushing = true;\n    S.ranOnce  = false;  // reset per consent cycle\n    S.tries    = 0;      // reset retries per cycle\n\n    (function check() {\n      if (typeof window.runPurge !== "function") {\n        if (S.tries++ < S.max) { setTimeout(check, S.delay); return; }\n        if (window.__OT_DEBUG) console.warn("[OT TEST] Purge engine not found after retries; continuing.");\n      }\n\n      S.flushing = false;\n\n      // Ensure single dispatch per cycle\n      if (!S.ranOnce) {\n        S.ranOnce = true;\n        dispatch(getG());\n      }\n    })();\n  }\n\n    // Official OneTrust lifecycle callback\n  window.OptanonWrapper = function () {\n    \n    // Run flush once after OneTrust loads\n    setTimeout(flush, 50);\n  };\n  \n})();\n</script>',language:"html"}}]},{id:"RLa7073774c61d4e989976d86d102b93f9",name:"Page Load - NLC - Setup (Non-Prod) (C0001) (50)",events:[{modulePath:"core/src/lib/events/windowLoaded.js",settings:{},ruleOrder:50},{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"OneTrust"},ruleOrder:40}],conditions:[{modulePath:"core/src/lib/conditions/subdomain.js",settings:{subdomains:[{value:"direct.pre-aviva.co.uk",valueIsRegex:!0},{value:"myworkplace.pre-aviva.co.uk",valueIsRegex:!0},{value:"direct.rwy-aviva.co.uk",valueIsRegex:!0}]}},{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"account-management-claims/",valueIsRegex:!0}]},negate:!0},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"equals"},leftOperand:"%dd-acquisition-insurance-quoteType%",rightOperand:"protection-simple-journey-delegate"},negate:!0},{modulePath:"core/src/lib/conditions/subdomain.js",settings:{subdomains:[{value:"help.pre-onlineaviva.co.uk",valueIsRegex:!0},{value:"pre-onlineaviva.co.uk",valueIsRegex:!0}]},negate:!0}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RC2f5502723c554cb09fde8a36c62acfe5-source.min.js",language:"javascript",isExternal:!0}},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/564c74edf9ea/2ab40e37dedf/7f4ebb848e6d/RC9a1ca69154574f6ba23c0b64f0ce84cd-source.min.js",language:"javascript",isExternal:!0}}]},{id:"RLa713ccfd7e9a4fc5a8fe6b9581685c1e",name:"Page Load - FNZ - Third party - ISA Apply - Set-Up Payment (Google) (C0004) (100)",events:[{modulePath:"core/src/lib/events/windowLoaded.js",settings:{},ruleOrder:100},{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"OneTrust"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator